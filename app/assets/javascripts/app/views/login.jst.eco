<!-- Redesign login SISKA (Tahap 0, mockup "SISKA Login & Register" /
Main.dc.html, kit Able Pro Authentication v2). SEMUA perilaku lama
dipertahankan (lihat docs/INVENTORY_LOGIN_REGISTER.md §3): maintenance,
pesan error/session timeout, provider pihak ketiga, login admin via
token, link mobile, public links. Titik pasang yg dipakai JS TIDAK
diganti: `#login` + `.js-form` (form & langkah 2FA, `renderTwoFactor`),
`.js-footer` (teks bantuan 2FA), `.hero-unit` (animasi shake), nama
field `username`/`password`/`remember_me`. `.js-footer` SENGAJA di luar
`.hero-unit`: `renderTwoFactor` menghapus semua saudara SETELAH
`.js-form` di dalam kartu. Teks footer lama ("You're already
registered ... request your password here") diringkas jadi subjudul +
link "Forgot password?". -->
<div class="siska-auth login">
  <%- App.view('siska_auth/side')() %>
  <main class="siska-auth-main">
    <div class="siska-auth-card hero-unit">
      <%- App.view('siska_auth/brand')(logoUrl: @logoUrl, title: App.i18n.translateContent('Sign in to %s', (@C('product_name') || '').split(' (')[0]), subtitle: App.i18n.translateContent('Use the email or username registered with our support team.')) %>

      <% if @C('maintenance_mode'): %>
        <div class="siska-auth-alert is-danger js-maintenanceMode" role="alert"><%- @T('Zammad is currently in maintenance mode. Only administrators can log in. Please wait until the maintenance window is over.') %></div>
      <% end %>
      <% if @C('maintenance_login') && @C('maintenance_login_message'): %>
        <div class="siska-auth-alert is-success js-maintenanceLogin" role="status"><%- @C('maintenance_login_message') %></div>
      <% end %>

      <% user_show_password_login = @C('user_show_password_login') || _.isEmpty(@auth_providers) %>

      <% if @item.showAdminPasswordLogin || user_show_password_login: %>
        <form id="login" class="siska-auth-form js-form">
          <% if @item.errorMessage: %>
            <div class="siska-auth-alert is-danger" role="alert">
              <%- @item.errorMessage %>
            </div>
          <% end %>

          <div class="form-group">
            <div class="formGroup-label">
              <label for="username"><%- @Ti('Username / email') %></label>
            </div>
            <input id="username" name="username" type="text" class="form-control" value="<%= @item.formPayload?.username %>" autocapitalize="off" autocomplete="username" />
          </div>

          <div class="form-group">
            <div class="formGroup-label">
              <label for="password"><%- @Ti('Password') %></label>
            </div>
            <div class="siska-auth-password">
              <input id="password" name="password" type="password" class="form-control" autocomplete="current-password"/>
              <button type="button" class="siska-auth-eye js-togglePassword" aria-label="<%- @Ti('Show password') %>" aria-pressed="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="siska-auth-row">
            <label class="inline-label checkbox-replacement">
              <input name="remember_me" value="1" type="checkbox">
              <%- @Icon('checkbox', 'icon-unchecked') %>
              <%- @Icon('checkbox-checked', 'icon-checked') %>
              <span class="label-text"><%- @T('Remember me') %></span>
            </label>
            <% if @C('user_lost_password'): %>
              <a href="#password_reset" class="siska-auth-link"><%- @T('Forgot password?') %></a>
            <% end %>
          </div>

          <button class="btn btn--primary siska-auth-submit" type="submit"><%- @T('Sign in') %></button>
        </form>
      <% else if @item.showAdminPasswordLoginFailed: %>
        <form id="login">
          <div class="siska-auth-alert is-danger" role="alert">
            <%- @T('The token for the admin password login is invalid.') %>
          </div>
        </form>
      <% end %>

      <% if !_.isEmpty(@auth_providers): %>
        <div class="siska-auth-separator">
          <span>
            <% if @C('user_show_password_login'): %>
              <%- @T('or sign in using') %>
            <% else: %>
              <%- @T('Sign in using') %>
            <% end %>
          </span>
        </div>

        <div class="auth-providers">
          <% for auth_provider in @auth_providers: %>
            <form method="post" action="<%= auth_provider.url %>">
              <input type="hidden" name="authenticity_token" value="<%= Spine.Ajax.defaults.headers['X-CSRF-Token'] %>">
              <button type="submit" class="auth-provider auth-provider--<%= auth_provider.class %>">
                <%- @Icon("#{auth_provider.class}-button", 'provider-icon') %>
                <span class="provider-name">
                  <%- @C("#{auth_provider.config}_display_name") || @T(auth_provider.name) %>
                </span>
              </button>
            </form>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="siska-auth-footer js-footer">
      <% show_user_create_account = @C('user_create_account') && user_show_password_login %>
      <% if show_user_create_account: %>
        <p class="siska-auth-switch">
          <span><%- @T("Don't have an account?") %></span>
          <a href="#signup" class="siska-auth-link"><%- @T('Create account') %></a>
        </p>
      <% end %>

      <% if !user_show_password_login: %>
        <p class="siska-auth-note">
          <%- @T('If you have problems with the third-party login you can request a one-time password login as an admin.') %>
          <a href="#admin_password_auth" class="siska-auth-link"><%- @T('Request the password login here.') %></a>
        </p>
      <% end %>

      <% if @show_mobile_link: %>
        <p class="siska-auth-note">
          <a href="#" class="siska-auth-link js-go-to-mobile"><%- @T('Continue to mobile') %></a>
        </p>
      <% end %>
    </div>

    <%- App.view('siska_auth/footer')(public_links: @public_links) %>
  </main>
</div>
