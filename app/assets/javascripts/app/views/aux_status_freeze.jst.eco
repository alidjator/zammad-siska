<div class="aux-status-freeze">
  <div class="aux-status-freeze-card">
    <div class="aux-status-freeze-icon"><%- @Icon('clock') %></div>
    <div class="aux-status-freeze-status"><%= @statusName %></div>
    <div class="js-aux-status-countdown aux-status-freeze-countdown">--:--</div>
    <div class="aux-status-freeze-note"><%- @T('During this status, new chats and tickets are not assigned to you. You stay online.') %></div>
    <div class="aux-status-freeze-chats js-aux-status-chats hide" role="status"><%- @Icon('chat') %><span class="js-aux-status-chats-text"></span></div>
    <button type="button" class="aux-kit-btn aux-kit-btn-primary js-aux-status-end-break"><%- @T('End Break Now') %></button>
  </div>
</div>
