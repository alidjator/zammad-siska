<!-- Redesign auth SISKA (Tahap 0). KONTEN SAJA -- dirender via
`@html` ke dalam root yg dibuat `admin_password_auth/request`. -->
  <%- App.view('siska_auth/side')() %>
<main class="siska-auth-main">
  <div class="siska-auth-card hero-unit">
    <%- App.view('siska_auth/brand')(icon: 'mail', title: App.i18n.translateContent('Admin password login instructions were sent to your email address.'), subtitle: App.i18n.translateContent('If you don\'t receive instructions within a minute or two, check your email\'s spam and junk filters, or try resending your request.')) %>
    <button class="btn btn--primary siska-auth-submit retry"><%- @T('Send again') %></button>
    <p class="siska-auth-back"><a href="#login" class="siska-auth-link js-cancel"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg><%- @T('Cancel & Go Back') %></a></p>
  </div>
  <%- App.view('siska_auth/footer')(public_links: []) %>
</main>
