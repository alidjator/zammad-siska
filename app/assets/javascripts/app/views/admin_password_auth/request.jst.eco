<!-- Redesign auth SISKA (Tahap 0, mockup "SISKA Login & Register",
kit Able Pro Authentication v2) -- tampilan saja, alur & titik pasang
JS (kelas js-*, `form`, `.retry`) tidak diubah.  -->
<div class="siska-auth request_admin_password_auth">
  <%- App.view('siska_auth/side')() %>
  <main class="siska-auth-main">
    <div class="siska-auth-card hero-unit">
      <%- App.view('siska_auth/brand')(icon: 'shield', title: App.i18n.translateContent('Request password login for admin?')) %>
      <form class="siska-auth-form js-adminPasswordAuthForm">
        <div class="js-adminPassword"></div>
        <button class="btn btn--primary siska-auth-submit js-submit"><%- @T('Submit') %></button>
      </form>
      <p class="siska-auth-back"><a href="#login" class="siska-auth-link js-cancel"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg><%- @T('Cancel & Go Back') %></a></p>
    </div>
    <%- App.view('siska_auth/footer')(public_links: []) %>
  </main>
</div>
