<!-- Redesign register SISKA -- Tahap 1: checklist aturan password
(Signup#renderPasswordRules). Petunjuk visual saja; validasi tetap di
server (PasswordPolicy). -->
<ul class="siska-auth-rules js-passwordRules" aria-live="polite">
  <% for rule in @rules: %>
    <li class="siska-auth-rule js-passwordRule" data-rule="<%= rule.key %>">
      <svg class="siska-auth-rule-ok" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>
      <svg class="siska-auth-rule-todo" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/></svg>
      <span><%= rule.label %></span>
    </li>
  <% end %>
</ul>
