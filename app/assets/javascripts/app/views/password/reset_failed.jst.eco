<!-- Redesign auth SISKA (Tahap 0, mockup "SISKA Login & Register",
kit Able Pro Authentication v2) -- tampilan saja, alur & titik pasang
JS (kelas js-*, `form`, `.retry`) tidak diubah.  -->
<div class="siska-auth reset_password">
  <%- App.view('siska_auth/side')() %>
  <main class="siska-auth-main">
    <div class="siska-auth-card hero-unit">
      <%- App.view('siska_auth/brand')(align: 'start', logoUrl: "/api/v1/system_assets/product_logo/#{@C('product_logo')}", asideHref: '#login', asideLabel: App.i18n.translateContent('Back to Login'), title: App.i18n.translateContent(@head), subtitle: App.i18n.translateContent(@message)) %>
      <a href="#password_reset" class="btn btn--primary siska-auth-submit retry"><%- @T('try again') %></a>
    </div>
    <%- App.view('siska_auth/footer')(public_links: @public_links) %>
  </main>
</div>
