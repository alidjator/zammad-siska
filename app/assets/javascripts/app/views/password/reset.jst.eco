<!-- Redesign auth SISKA (Tahap 0, mockup "SISKA Login & Register",
kit Able Pro Authentication v2) -- tampilan saja, alur & titik pasang
JS (kelas js-*, `form`, `.retry`) tidak diubah.  -->
<div class="siska-auth reset_password">
  <%- App.view('siska_auth/side')() %>
  <main class="siska-auth-main">
    <div class="siska-auth-card hero-unit">
      <%- App.view('siska_auth/brand')(icon: 'key', title: App.i18n.translateContent('Forgot your password?'), subtitle: App.i18n.translateContent('Enter the email or username of your account. We will send you instructions to reset your password.')) %>
      <form class="siska-auth-form js-passwordForm">
        <div class="js-password"></div>
        <button class="btn btn--primary siska-auth-submit js-submit"><%- @T('Submit') %></button>
      </form>
      <p class="siska-auth-back"><a href="#login" class="siska-auth-link js-cancel"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg><%- @T('Back to sign in') %></a></p>
    </div>
    <%- App.view('siska_auth/footer')(public_links: @public_links) %>
  </main>
</div>
