<!-- Redesign auth SISKA (Tahap 0, mockup "SISKA Login & Register",
kit Able Pro Authentication v2) -- tampilan saja, alur & titik pasang
JS (kelas js-*, `form`, `.retry`) tidak diubah. Dirender PasswordResetVerify (link reset di email). -->
<div class="siska-auth reset_password">
  <%- App.view('siska_auth/side')() %>
  <main class="siska-auth-main">
    <div class="siska-auth-card hero-unit">
      <%- App.view('siska_auth/brand')(align: 'start', logoUrl: "/api/v1/system_assets/product_logo/#{@C('product_logo')}", asideHref: '#/', asideLabel: App.i18n.translateContent('Back to Login'), title: App.i18n.translateContent('Choose your new password.')) %>
      <form class="siska-auth-form js-passwordForm">
        <div class="js-password"></div>
        <button class="btn btn--primary siska-auth-submit js-submit"><%- @T('Submit') %></button>
      </form>
    </div>
    <%- App.view('siska_auth/footer')(public_links: @public_links) %>
  </main>
</div>
