<!-- Redesign lupa password SISKA -- Tahap 3 (OTP), pola kit
code-verification-v2 spt layar kode register (signup/verify). Dirender
PasswordReset#renderOtp. Alamat tujuan TIDAK ditampilkan tersamar --
yg diketik user (username/email) ditampilkan apa adanya, dgn kalimat
"kalau ada akun ..." supaya tidak membocorkan akun mana yg terdaftar.
`@state`: null | 'incorrect' | 'expired' | 'too_many_attempts' |
'resent' | 'cooldown' | 'rate_limited' | 'error'. -->
<div class="siska-auth reset_password">
  <%- App.view('siska_auth/side')() %>
  <main class="siska-auth-main">
    <div class="siska-auth-card hero-unit">
      <%- App.view('siska_auth/brand')(align: 'start', logoUrl: "/api/v1/system_assets/product_logo/#{@C('product_logo')}", asideHref: '#login', asideLabel: App.i18n.translateContent('Back to Login'), title: App.i18n.translateContent('Check your email'), subtitle: App.i18n.translateContent('Enter the 6-digit code to reset your password.')) %>
      <!-- Isian dimasukkan SETELAH diterjemahkan (penanda {{identifier}}),
      bukan sbg argumen %s: translateContent menerapkan markup link
      `[teks](url)` sesudah argumen disisipkan. -->
      <p class="siska-auth-sentto"><%- App.i18n.translateContent('If an account exists for %s, we sent a code to its email address.', '{{identifier}}').replace('{{identifier}}', "<strong>#{App.Utils.htmlEscape(@identifier)}</strong>") %></p>

      <% if @state is 'incorrect': %>
        <div class="siska-auth-alert is-danger" role="alert"><%- @T('The code is incorrect. %s attempts left.', @attemptsLeft) %></div>
      <% else if @state is 'expired': %>
        <div class="siska-auth-alert is-warning" role="alert"><%- @T('This code has expired. Request a new code to continue.') %></div>
      <% else if @state is 'too_many_attempts': %>
        <div class="siska-auth-alert is-danger" role="alert"><%- @T('Too many incorrect attempts. Request a new code to try again.') %></div>
      <% else if @state is 'resent': %>
        <div class="siska-auth-alert is-success" role="status"><%- @T('A new code has been sent.') %></div>
      <% else if @state is 'rate_limited': %>
        <div class="siska-auth-alert is-warning" role="alert"><%- @T('Too many codes requested. Please wait a few minutes before requesting a new one.') %></div>
      <% else if @state is 'error': %>
        <div class="siska-auth-alert is-danger" role="alert"><%- @T('Could not process your request') %></div>
      <% end %>

      <form class="siska-auth-form js-otpForm" novalidate>
        <div class="siska-auth-otp<%= ' is-invalid' if @state is 'incorrect' %>" role="group" aria-label="<%- @Ti('Verification code') %>">
          <% for i in [0..5]: %>
            <input class="siska-auth-otp-digit js-otpDigit" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="<%= if i is 0 then 'one-time-code' else 'off' %>" placeholder="0" aria-label="<%- @Ti('Digit %s', i + 1) %>"<%= ' disabled' if @locked %>>
          <% end %>
        </div>
        <button class="btn btn--primary siska-auth-submit js-otpSubmit" type="submit"<%= ' disabled' if @locked %>><%- @T('Continue') %></button>
      </form>

      <p class="siska-auth-resend is-start">
        <span><%- @T("Didn't get the email?") %></span>
        <button type="button" class="siska-auth-link js-otpResend"<%= ' disabled' if @cooldown > 0 %>>
          <% if @cooldown > 0: %><%- @T('Resend code in %s', @cooldownLabel) %><% else: %><%- @T('Resend code') %><% end %>
        </button>
      </p>
      <p class="siska-auth-text siska-auth-small"><%- @T('Check your junk or spam folder. The email also contains a link you can use instead of the code.') %></p>

      <p class="siska-auth-back"><a href="#password_reset" class="siska-auth-link js-changeIdentity"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg><%- @T('Use a different email or username') %></a></p>
    </div>
    <%- App.view('siska_auth/footer')(public_links: @public_links) %>
  </main>
</div>
