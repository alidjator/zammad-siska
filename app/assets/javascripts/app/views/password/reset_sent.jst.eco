<!-- Redesign auth SISKA (Tahap 0). KONTEN SAJA (tanpa pembungkus
root `.siska-auth`) -- dirender via `@html` ke dalam root yg dibuat
`password/reset` (PasswordReset#submit), supaya layout tidak bersarang.
Tombol `.retry` (event controller) dipertahankan. -->
  <%- App.view('siska_auth/side')() %>
<main class="siska-auth-main">
  <div class="siska-auth-card hero-unit">
    <%- App.view('siska_auth/brand')(align: 'start', logoUrl: "/api/v1/system_assets/product_logo/#{@C('product_logo')}", asideHref: '#login', asideLabel: App.i18n.translateContent('Back to Login'), title: App.i18n.translateContent('Password reset instructions were sent to your email address.'), subtitle: App.i18n.translateContent('If you don\'t receive instructions within a minute or two, check your email\'s spam and junk filters, or try resending your request.')) %>
    <button class="btn btn--primary siska-auth-submit retry"><%- @T('Send again') %></button>
  </div>
  <%- App.view('siska_auth/footer')(public_links: @public_links) %>
</main>
