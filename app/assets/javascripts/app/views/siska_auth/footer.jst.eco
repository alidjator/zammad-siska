<!-- Footer halaman auth: public links (bila ada) + branding SISKA,
menggantikan "Powered by Zammad" (keputusan K5). -->
<footer class="siska-auth-copy">
  <% if !_.isEmpty(@public_links): %>
    <nav class="siska-auth-links">
      <% for link in @public_links: %>
        <a href="<%= link.link %>"<% if link.description: %> title="<%- @T(link.description) %>"<% end %><% if link.new_tab: %> rel="noopener noreferrer" target="_blank"<% end %>><%- @T(link.title) %></a>
      <% end %>
    </nav>
  <% end %>
  <span>© <%= (@C('product_name') || '') %> · <%= @C('fqdn') %></span>
</footer>
