<!-- Kepala kartu auth. Dua varian, mengikuti kit Able Pro v2:
- tengah (default, login-v2/register-v2): logo/ikon bulat, judul h4
  20px medium, subjudul;
- `@align is 'start'` (code-verification-v2 / forgot-password-v2):
  logo rata kiri, judul h3 24px tebal, opsional link `@asideHref`/
  `@asideLabel` di kanan judul ("Back to Login"), subjudul abu2.
`@title`/`@subtitle` sudah diterjemahkan & di-escape oleh pemanggil. -->
<div class="siska-auth-brand<%= ' is-start' if @align is 'start' %>">
  <% if @logoUrl: %>
    <img class="siska-auth-logo" src="<%= @logoUrl %>" alt="<%= @C('product_name') %>">
  <% else if @icon: %>
    <span class="siska-auth-icon is-<%= @iconTone || 'primary' %>" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <% if @icon is 'key': %><circle cx="8" cy="15" r="4"/><path d="m10.8 12.2 8.2-8.2"/><path d="m16 7 3 3"/><path d="m18 5 2 2"/>
        <% else if @icon is 'mail': %><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
        <% else if @icon is 'check': %><path d="m5 12 5 5 9-10"/>
        <% else if @icon is 'lock': %><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        <% else if @icon is 'shield': %><path d="M12 3 5 6v6c0 4 3 7.5 7 9 4-1.5 7-5 7-9V6z"/>
        <% else: %><circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><path d="M12 16h.01"/>
        <% end %>
      </svg>
    </span>
  <% end %>
  <% if @asideHref: %>
    <div class="siska-auth-titlebar">
      <h1 class="siska-auth-title"><%- @title %></h1>
      <a href="<%= @asideHref %>" class="siska-auth-link js-cancel"><%- @asideLabel %></a>
    </div>
  <% else: %>
    <h1 class="siska-auth-title"><%- @title %></h1>
  <% end %>
  <% if @subtitle: %>
    <p class="siska-auth-subtitle"><%- @subtitle %></p>
  <% end %>
</div>
