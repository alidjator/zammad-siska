<div class="chat main siska-agent siska-chat-page">
  <div class="siska-settings-view js-settingsView hidden"></div>
  <div class="siska-chat-header js-chatView">
    <div class="siska-chat-header-title">
      <h1 class="s-h1"><%- @T('Customer Chat') %></h1>
      <div class="s-muted s-small js-summary"></div>
    </div>
    <div class="siska-chat-header-actions">
      <label class="s-switch siska-chat-online">
        <input type="checkbox" class="js-onlineSwitch">
        <span class="js-onlineLabel"></span>
      </label>
      <button type="button" class="s-btn s-btn-outline-secondary siska-chat-settings js-settings">
        <%- @SiskaIcon('gear-six', 16) %>
        <%- @T('Settings') %>
      </button>
    </div>
  </div>
  <!-- G7: koneksi WebSocket putus (sebelum modal global Zammad muncul) -->
  <div class="s-alert s-alert-danger siska-chat-connection js-chatView js-connectionBanner hidden" role="alert">
    <span class="siska-thread-spin"><%- @SiskaIcon('spinner-gap', 20) %></span>
    <span class="siska-chat-offline-text"><%- @T('Connection lost. Reconnecting… Messages you send will be delivered once the connection is back.') %></span>
  </div>
  <div class="s-alert s-alert-warning siska-chat-offline js-chatView js-offlineBanner hidden" role="status">
    <%- @SiskaIcon('wifi-slash', 20) %>
    <span class="siska-chat-offline-text"><%- @T('You are |offline|. New chats will not be assigned to you until you go online.') %></span>
    <button type="button" class="s-btn s-btn-primary s-btn-sm js-goOnline"><%- @T('Go online') %></button>
  </div>
  <div class="siska-chat-layout js-chatView">
    <aside class="s-card siska-chat-list">
      <div class="siska-chat-list-search">
        <div class="s-input-icon">
          <%- @SiskaIcon('magnifying-glass', 16) %>
          <input type="search" class="s-form-control js-listSearch" placeholder="<%- @Ti('Search chats') %>" aria-label="<%- @Ti('Search chats') %>">
        </div>
      </div>
      <div class="siska-chat-list-body js-list"></div>
    </aside>
    <section class="siska-chat-detail">
      <div class="s-card siska-chat-empty js-detailEmpty">
        <span class="siska-chat-empty-icon"><%- @SiskaIcon('chats', 32, tone: 'full') %></span>
        <div class="s-h2"><%- @T('No conversation selected') %></div>
        <div class="s-muted"><%- @T('Pick a chat from the list, or accept a waiting customer.') %></div>
      </div>
      <div class="chat-workspace"></div>
      <div class="s-card siska-accept-overlay js-acceptOverlay hidden"></div>
    </section>
  </div>
</div>
