<div class="chat-header">
  <div class="chat-status js-status" data-status="online">
    <div class="chat-status-holder">
      <%- @Icon('status') %>
      <%- @Icon('status-modified-outer-circle') %>
      <%- @Icon('small-dot', 'icon-status-modified-inner-circle') %>
    </div>
  </div>
  <div class="chat-name">
    <span class="js-name js-info u-clickable"><%= @name %><span> #<%= @session.id %>
  </div>
  <div class="chat-disconnect js-disconnect">
    <div class="btn btn--action btn--small"><%- @T('disconnect') %></div>
  </div>
  <div class="chat-close js-close is-hidden">
    <div class="btn btn--action btn--small"><%- @T('close') %></div>
  </div>
</div>
<div class="chat-scroll-hint js-scrollHint is-hidden">
  <%- @Icon('chat') %>
  <%- @T('Scroll down to see new messages') %>
</div>
<div class="chat-body-holder js-scrollHolder">
  <div class="chat-body js-body"></div>
  <div class="chat-body js-meta hidden">
    <% if @session: %>
    <%- @T('Transfer conversation to another chat:') %>
    <ul>
      <% for chat in @chats: %>
        <% if @session.chat_id isnt chat.id: %>
          <li><a data-chat-id="<%= chat.id %>" class="js-transferChat" href="#"><%- chat.name %></a>
        <% end %>
      <% end %>
    </ul>
    <hr>
    <ul>
      <li><%- @T('Created at:') %> <%- @Ttimestamp(@session.created_at) %></li>
      <% if @session.ticket_id: %>
        <!-- Atas permintaan user: tiket auto-create (Item 5) sudah
             dibuat sejak chat MULAI, tapi link ke tiket itu (tombol
             "Open Ticket" bawaan) baru muncul native SETELAH chat
             berakhir (goOffline). Ditambahkan di sini supaya terlihat
             SELAMA chat masih berlangsung juga -- pakai class
             `js-openPreviousTicket` yang SUDAH ADA (5.1.7), bukan
             handler baru, karena perilakunya (navigate ke tiket)
             persis sama. -->
        <li><%- @T('Ticket:') %> <a href="#" class="js-openPreviousTicket" data-ticket-id="<%= @session.ticket_id %>"><%- @T('Open Ticket') %></a></li>
      <% end %>
      <% if @previousSessions && @previousSessions.length: %>
        <li>
          <%- @T('Previous chats from this visitor:') %>
          <ul class="js-previousSessions">
            <% for previous in @previousSessions: %>
              <li>
                <!-- Atas permintaan user: bukan cuma tanggal+link tiket,
                     tapi transkrip LENGKAP sesi itu, supaya agent tidak
                     perlu pindah ke tiket lama cuma untuk baca ulang.
                     Dibungkus <details> (collapsed by default, native
                     browser, tanpa JS tambahan) supaya panel tidak
                     langsung penuh kalau ada beberapa sesi sebelumnya. -->
                <details class="chat-previous-session">
                  <summary>
                    <%- @Ttimestamp(previous.created_at) %>
                    <% if previous.ticket_id: %>
                      -- <a href="#" class="js-openPreviousTicket" data-ticket-id="<%= previous.ticket_id %>"><%- @T('Open Ticket') %></a>
                    <% end %>
                  </summary>
                  <ul class="js-previousMessages">
                    <% if previous.messages && previous.messages.length: %>
                      <% for message in previous.messages: %>
                        <li>
                          <strong><%- if message.is_from_agent then @T('Agent') else @T('Customer') %>:</strong>
                          <%- message.content %>
                        </li>
                      <% end %>
                    <% else: %>
                      <li><%- @T('(no messages)') %></li>
                    <% end %>
                  </ul>
                </details>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
      <% if @session && @session.preferences: %>
        <% if @session.preferences.geo_ip: %>
          <li>GeoIP: <%= @session.preferences.geo_ip.country_name %> <%= @session.preferences.geo_ip.city_name %></li>
        <% end %>
        <% if @session.preferences.remote_ip: %>
          <li>IP: <%= @session.preferences.remote_ip %></li>
        <% end %>
        <% if @session.preferences.dns_name: %>
          <li>DNS: <%= @session.preferences.dns_name %></li>
        <% end %>
      <% end %>
    </ul>
    <% end %>
    <form class="js-metaForm" style="max-width: 200px; width: 100%;"></form>
  </div>
</div>
<div class="chat-reply-indicator js-replyIndicator hidden"></div>
<div class="chat-controls">
  <div class="chat-attach js-attachButton">
    <%- @Icon('paperclip') %>
  </div>
  <input type="file" class="js-attachmentInput hidden">
  <div class="chat-input">
    <div class="form-control form-control--small form-control--multiline js-customerChatInput" contenteditable="true"></div>
  </div>
  <div class="btn btn--primary btn--slim btn--small js-send"><%- @T('Send') %></div>
</div>