<div class="siska-msg siska-msg--<%= @sender %><%= ' chat-message--new' if @isNew %>"<% if @messageId: %> data-message-id="<%= @messageId %>"<% end %><% if @pendingId: %> data-pending-id="<%= @pendingId %>"<% end %>>
  <% if @sender is 'customer': %>
    <span class="s-avatar s-avatar-sm siska-msg-avatar" aria-hidden="true"><%= @initials %></span>
  <% end %>
  <div class="siska-msg-main">
    <div class="siska-msg-meta"><%= @author %> <span class="siska-msg-time"><%= @time %></span><% if @sender is 'agent': %><span class="siska-msg-status js-msgStatus<%= ' is-read' if @isRead %>" role="img" aria-label="<%- @Ti(if @isRead then 'Read by customer' else 'Sent') %>" title="<%- @Ti(if @isRead then 'Read by customer' else 'Sent') %>"><%- @SiskaIcon('checks', 16) %></span><% end %></div>
    <div class="siska-msg-row">
      <div class="siska-msg-bubble siska-msg-bubble--<%= @kind %>">
        <% if @replyTo: %>
          <div class="siska-msg-quote"><%= @replyTo %></div>
        <% end %>
        <% if @kind is 'image': %>
          <!-- Kartu gambar (mockup "Kartu pratinjau gambar", keputusan user:
               putih bergaris utk customer & agent): pratinjau 240x180 crop
               penuh + kaki kartu nama file, tipe · ukuran, tombol unduh. -->
          <div class="siska-img-card">
            <button type="button" class="siska-msg-image js-siskaImage" aria-label="<%- @Ti('Preview %s', @file.name) %>">
              <img src="<%= @file.previewUrl %>" alt="<%= @file.name %>" loading="lazy">
            </button>
            <div class="siska-img-card-foot">
              <span class="siska-img-card-text">
                <span class="siska-img-card-name" title="<%= @file.name %>"><%= @file.name %></span>
                <% if @file.meta: %><span class="siska-img-card-meta"><%= @file.meta %></span><% end %>
              </span>
              <a class="siska-img-card-download" href="<%= @file.downloadUrl %>" target="_blank" rel="noopener" download aria-label="<%- @Ti('Download %s', @file.name) %>"><%- @SiskaIcon('download-simple', 18) %></a>
            </div>
          </div>
        <% else if @kind is 'file': %>
          <a class="siska-msg-file" href="<%= @file.downloadUrl %>" target="_blank" rel="noopener" download>
            <span class="siska-file-icon siska-tone-<%= @file.tone %>"><%- @SiskaIcon(@file.icon, 20) %></span>
            <span class="siska-msg-file-text">
              <span class="siska-msg-file-name"><%= @file.name %></span>
              <span class="siska-msg-file-meta"><%= @file.meta %></span>
            </span>
            <span class="siska-msg-file-download"><%- @SiskaIcon('download-simple', 18) %></span>
          </a>
        <% else: %>
          <div class="siska-msg-text"><%- @html %></div>
        <% end %>
        <% if @sender is 'customer': %>
          <!-- G3: reaksi AGENT ke pesan customer; klik = hapus (bukan di riwayat) -->
          <% if @history: %>
            <span class="siska-msg-reaction<%= ' hidden' if !@agentReaction %>"<% if @agentReaction: %> role="img" aria-label="<%- @Ti('Your reaction: %s', @agentReactionLabel) %>"<% end %>><%= @agentReaction %></span>
          <% else: %>
            <button type="button" class="siska-msg-reaction siska-msg-reaction--own js-agentReaction<%= ' hidden' if !@agentReaction %>" aria-label="<%- @Ti('Your reaction: %s. Remove', @agentReactionLabel || '') %>"><%= @agentReaction %></button>
          <% end %>
        <% end %>
        <% if @sender is 'agent': %>
          <span class="siska-msg-reaction js-reaction<%= ' hidden' if !@reaction %>"<% if @reaction: %> aria-label="<%- @Ti('Customer reaction: %s', @reactionLabel) %>"<% end %>><%= @reaction %></span>
        <% end %>
      </div>
      <% if !@history or @file or @kind is 'text': %>
      <div class="siska-msg-menu js-msgMenu">
        <button type="button" class="s-btn s-btn-link s-btn-icon s-btn-sm siska-msg-menu-toggle js-msgMenuToggle" aria-label="<%- @Ti('Message options') %>" aria-haspopup="menu" aria-expanded="false"><%- @SiskaIcon('dots-three-vertical', 18) %></button>
        <div class="s-menu siska-msg-menu-list hidden" role="menu" aria-label="<%- @Ti('Message options') %>">
          <% if @sender is 'customer' and !@history and @messageId: %>
            <div class="siska-reaction-row" role="group" aria-label="<%- @Ti('React') %>">
              <% for item in @reactions: %>
                <button type="button" class="siska-reaction-item js-reactMessage<%= ' is-active' if item.emoji is @agentReaction %>" role="menuitemradio" aria-checked="<%= if item.emoji is @agentReaction then 'true' else 'false' %>" aria-label="<%- @Ti(item.label) %>" data-reaction="<%= item.emoji %>"><%= item.emoji %></button>
              <% end %>
            </div>
          <% end %>
          <% if !@history: %><button type="button" class="s-menu-item js-replyMessage" role="menuitem"><%- @SiskaIcon('arrow-bend-up-left', 16) %><%- @T('Reply') %></button><% end %>
          <% if @kind is 'text': %><button type="button" class="s-menu-item js-copyMessage" role="menuitem"><%- @SiskaIcon('copy', 16) %><%- @T('Copy') %></button><% end %>
          <% if @file: %>
            <a class="s-menu-item" role="menuitem" href="<%= @file.downloadUrl %>" target="_blank" rel="noopener" download><%- @SiskaIcon('download-simple', 16) %><%- @T('Download') %></a>
          <% end %>
        </div>
      </div>
      <% end %>
    </div>
  </div>
</div>
