<div class="team-kpi">

  <%# Filter bar (artboard TeamKpi-QuickWin, komponen kit; kepala: TeamKpi-HeadSplit opsi A + TeamKpi-PeriodRadio opsi B): %>
  <%# kartu kepala primary-50 berdiri sendiri (Periode radio + ornamen di ruang sisa + Ekspor), lalu kartu badan: form-select Grup/Pembanding, %>
  <%# Choices.js Prioritas/Kanal/Kategori, dan keterangan pembanding / diperbarui / reset. %>
  <div class="team-kpi-bar">
    <div class="team-kpi-bar-head">
      <div class="team-kpi-bar-left">
        <div class="team-kpi-bar-title">
          <span class="team-kpi-bar-title-icon"><%- @SiskaIcon('calendar', 20) %></span>
          <span>
            <span class="team-kpi-bar-title-text"><%- @T('Periode') %></span>
            <% if @periodRange: %><span class="team-kpi-bar-title-sub"><%= @periodRange %></span><% end %>
          </span>
        </div>
        <%# radio dalam kotak (artboard TeamKpi-PeriodRadio opsi B, pola mega option kit) %>
        <div class="team-kpi-period-opts" role="radiogroup" aria-label="<%- @T('Periode') %>">
          <% for p in @periods: %>
            <label class="team-kpi-period-opt <% if p.active: %>is-active<% end %>">
              <input type="radio" class="team-kpi-radio js-kpi-period" name="kpi-period" value="<%= p.days %>" data-days="<%= p.days %>" <% if p.active: %>checked<% end %>>
              <span><%= p.label %></span>
            </label>
          <% end %>
        </div>
      </div>
      <div class="team-kpi-bar-ornaments" aria-hidden="true"><svg class="team-kpi-bar-ornaments-svg" aria-hidden="true" focusable="false" width="480" height="76" viewBox="0 0 480 76"><circle cx="30" cy="22" r="6" fill="none" stroke="#f5b400" stroke-width="2.2"></circle><circle cx="88" cy="54" r="3" fill="#5cd6a9"></circle><polygon points="150.0,12.0 148.4,15.8 144.3,16.1 147.4,18.8 146.5,22.9 150.0,20.7 153.5,22.9 152.6,18.8 155.7,16.1 151.6,15.8" fill="#ffd66b"></polygon><path d="M206.4 43.6h11.2a4 4 0 0 1 4 4v4.800000000000001a4 4 0 0 1-4 4h-7.6l-5 5v-5h-2.5999999999999996a4 4 0 0 1-4-4v-4.800000000000001a4 4 0 0 1 4-4z" fill="#ffffff" stroke="#7da5fe" stroke-width="1.8" stroke-linejoin="round"></path><circle cx="207.6" cy="50" r="1.6" fill="#7da5fe"></circle><circle cx="212.0" cy="50" r="1.6" fill="#7da5fe"></circle><circle cx="216.4" cy="50" r="1.6" fill="#7da5fe"></circle><path d="M257 22h10M262 17v10" stroke="#b5cbfe" stroke-width="2.4" stroke-linecap="round"></path><path transform="translate(306 46) scale(0.67)" d="M0 5c0-5 7-7 9-2 2-5 9-3 9 2 0 6-9 11-9 11S0 11 0 5z" fill="#ff8a8a"></path><path d="M356 11C356.9 15.1 356.9 15.1 361 16C356.9 16.9 356.9 16.9 356 21C355.1 16.9 355.1 16.9 351 16C355.1 15.1 355.1 15.1 356 11z" fill="#3ec9d6"></path><circle cx="400" cy="58" r="4.5" fill="none" stroke="#ffb44d" stroke-width="2.2"></circle><path d="M440 14l3.6 6.0h-7.2z" fill="none" stroke="#7da5fe" stroke-width="2" stroke-linejoin="round"></path></svg></div>
      <button type="button" class="team-kpi-btn team-kpi-btn--outline team-kpi-btn--lg js-kpi-export" title="<%- @T('Unduh .xlsx sesuai filter yang aktif') %>">
        <%- @SiskaIcon('download-simple', 16) %> <%- @T('Ekspor .xlsx') %>
      </button>
    </div>
    <div class="team-kpi-bar-body">
    <div class="team-kpi-filters">
      <div class="team-kpi-field">
        <label class="team-kpi-form-label" for="kpi-f-group"><%- @T('Grup') %></label>
        <select id="kpi-f-group" class="team-kpi-form-select js-kpi-group">
          <option value=""><%- @T('Semua grup yang bisa diakses') %></option>
          <% for g in @groups: %>
            <option value="<%= g.id %>" <% if g.selected: %>selected<% end %>><%= g.name %></option>
          <% end %>
        </select>
      </div>
      <div class="team-kpi-field">
        <label class="team-kpi-form-label" for="kpi-f-compare"><%- @T('Pembanding') %></label>
        <select id="kpi-f-compare" class="team-kpi-form-select js-kpi-compare">
          <% for c in @compares: %>
            <option value="<%= c.value %>" <% if c.selected: %>selected<% end %>><%= c.label %></option>
          <% end %>
        </select>
      </div>
      <% for f in @multiFilters: %>
        <div class="team-kpi-field">
          <label class="team-kpi-form-label" id="kpi-f-<%= f.key %>-label" for="kpi-f-<%= f.key %>"><%= f.label %></label>
          <select id="kpi-f-<%= f.key %>" class="team-kpi-multi js-kpi-multi" multiple data-filter="<%= f.key %>" data-placeholder="<%= f.placeholder %>" aria-labelledby="kpi-f-<%= f.key %>-label">
            <% for o in f.options: %>
              <option value="<%= o.value %>" <% if o.selected: %>selected<% end %> <% if o.count?: %>data-label-description="<%= o.count %>"<% end %>><%= o.label %></option>
            <% end %>
          </select>
        </div>
      <% end %>
    </div>
    <div class="team-kpi-bar-meta">
      <span class="team-kpi-bar-meta-info">
        <span>
          <% if @cmpRange: %>
            <%- @T('Dibanding') %>: <b><%= @cmpRange %></b>
          <% else if @summary: %>
            <%= @noCmpNote %>
          <% end %>
        </span>
        <span class="team-kpi-updated">
          <%- @SiskaIcon('clock-counter-clockwise', 14) %>
          <% if @refreshing || @loading: %><%- @T('Memuat…') %><% else if @updatedAt: %><%- @T('Diperbarui') %> <%= @updatedAt %><% end %>
        </span>
      </span>
      <% if @hasFilters: %>
        <button type="button" class="team-kpi-btn team-kpi-btn--link js-kpi-reset"><%- @SiskaIcon('x', 14) %> <%- @T('Reset filter') %></button>
      <% end %>
    </div>
    </div>
  </div>

  <% if @stale: %>
    <div class="team-kpi-banner is-warning" role="status">
      <%- @SiskaIcon('warning', 16) %>
      <span><%- @T('Sebagian data gagal dimuat. Angka yang tampil adalah data terakhir pukul %s.', @updatedAt) %></span>
      <a href="#" class="js-kpi-retry"><%- @T('Coba lagi') %></a>
    </div>
  <% end %>

  <% if @failedAll: %>
    <div class="team-kpi-card team-kpi-state" role="alert">
      <span class="team-kpi-state-icon is-danger"><%- @SiskaIcon('x-circle', 22) %></span>
      <div class="team-kpi-state-title"><%- @T('Gagal memuat KPI Tim') %></div>
      <div class="team-kpi-muted"><%- @T('Server tidak merespons. Coba beberapa saat lagi.') %></div>
      <button type="button" class="team-kpi-btn team-kpi-btn--outline js-kpi-retry"><%- @T('Coba lagi') %></button>
    </div>
  <% else if @loading: %>
    <div class="team-kpi-cards" aria-busy="true">
      <% for i in [1..6]: %>
        <div class="team-kpi-card team-kpi-skeleton"><span></span><span></span><span></span></div>
      <% end %>
    </div>
  <% end %>

  <% if @summary: %>

  <div class="team-kpi-card team-kpi-queue">
    <div class="team-kpi-queue-title">
      <span class="team-kpi-live-dot"></span>
      <div>
        <b><%- @T('Antrian real-time') %></b>
        <div class="team-kpi-muted"><%= @queue.note %></div>
      </div>
    </div>
    <div class="team-kpi-queue-items">
      <a href="#ticket/view/all_open" class="team-kpi-queue-item" title="<%- @T('Buka daftar tiket aktif') %>">
        <span><%- @T('Total aktif') %></span><b><%= @queue.total %></b><% if @queue.dTotal: %><em class="<%= @queue.dTotal.cls %>"><%= @queue.dTotal.text %></em><% end %>
      </a>
      <a href="#ticket/view/new" class="team-kpi-queue-item" title="<%- @T('Buka daftar tiket New') %>">
        <span><%- @T('New') %></span><b><%= @queue.new %></b><small><%= @queue.newPct %>%</small><% if @queue.dNew: %><em class="<%= @queue.dNew.cls %>"><%= @queue.dNew.text %></em><% end %>
      </a>
      <a href="#ticket/view/all_open" class="team-kpi-queue-item" title="<%- @T('Buka daftar tiket Open') %>">
        <span><%- @T('Open') %></span><b><%= @queue.open %></b><small><%= @queue.openPct %>%</small><% if @queue.dOpen: %><em class="<%= @queue.dOpen.cls %>"><%= @queue.dOpen.text %></em><% end %>
      </a>
      <a href="#ticket/view/all_escalated" class="team-kpi-queue-item" title="<%- @T('Buka daftar tiket yang lewat SLA') %>">
        <span><%- @T('Escalated') %></span><b class="is-bad"><%= @queue.escalated %></b><small><%- @T('lewat SLA') %></small><% if @queue.dEsc: %><em class="<%= @queue.dEsc.cls %>"><%= @queue.dEsc.text %></em><% end %>
      </a>
    </div>
  </div>

  <div class="team-kpi-cards">
    <% for k in @cards: %>
      <div class="team-kpi-card team-kpi-score">
        <%- k.illusHtml %>
        <div class="team-kpi-score-head">
          <div class="team-kpi-score-title">
            <span><%= k.title %></span>
            <span class="team-kpi-help js-kpi-tip" tabindex="0" title="<%= k.help %>" aria-label="<%- @T('Definisi') %> <%= k.title %>"><%- @SiskaIcon('info', 14) %></span>
          </div>
          <div class="team-kpi-score-meta">
            <span class="team-kpi-basis <% if k.live: %>is-live<% end %>"><i></i><%= k.basis %></span>
            <% if k.stateLabel: %>
              <span class="team-kpi-badge is-<%= k.stateKey %>" title="state: <%= k.state || '-' %>"><%= k.stateLabel %></span>
            <% end %>
          </div>
        </div>

        <%# anatomi seragam: angka = KPI (warna netral), status hanya lewat pill + skala, %>
        <%# warna hijau/merah hanya di baris perubahan (membaik/memburuk) %>
        <div class="team-kpi-value <% if k.empty: %>is-empty<% end %>">
          <%= k.value %><% if k.unit: %><small><%= k.unit %></small><% end %>
        </div>

        <div class="team-kpi-delta">
          <% if k.deltaText: %>
            <b class="<%= k.deltaCls %>"><%= k.deltaText %></b> <%= k.deltaVs %>
          <% else: %>
            <b class="is-flat">—</b> <%= k.deltaNote %>
          <% end %>
        </div>

        <% if k.context: %>
          <div class="team-kpi-context"><%- @SiskaIcon('clock', 14) %><span><%= k.context %></span></div>
        <% end %>

        <% if k.scale: %>
          <div class="team-kpi-scale">
            <% for g in k.scale.segs: %>
              <i class="js-kpi-tip is-<%= g.state %> <% if g.active: %>is-active<% end %>" title="<%= g.tip %>"></i>
            <% end %>
          </div>
          <div class="team-kpi-scale-caption"><span><%= k.scale.first %></span><% if k.n?: %><span>n <%= k.n %> <%= k.nLabel %></span><% end %></div>
        <% else if k.noTarget: %>
          <div class="team-kpi-scale is-unset" aria-hidden="true"></div>
          <div class="team-kpi-scale-caption"><span><%- @T('Target belum diatur') %></span><% if k.n?: %><span>n <%= k.n %> <%= k.nLabel %></span><% end %></div>
        <% else if k.n?: %>
          <div class="team-kpi-scale-caption"><span></span><span>n <%= k.n %> <%= k.nLabel %></span></div>
        <% end %>

        <% if k.small: %>
          <div class="team-kpi-note is-warning"><%- @SiskaIcon('warning', 14) %> <%- @T('Sampel kecil (n < 30), tafsirkan hati-hati') %></div>
        <% end %>

        <% if k.coverage: %>
          <div class="team-kpi-note <% if k.coverage.low: %>is-warning<% end %>">
            <% if k.coverage.low: %><%- @SiskaIcon('warning', 14) %><% end %>
            <span><%- @T('Cakupan rating') %> <b><%= k.coverage.pct %>%</b> (<%= k.coverage.rated %> <%- @T('dari') %> <%= k.coverage.closed %> <%- @T('tiket closed') %>)<% if k.coverage.low: %>, <%- @T('belum representatif') %><% end %></span>
          </div>
        <% end %>

        <% if !k.hideFoot or k.drill: %>
        <div class="team-kpi-foot">
          <span class="team-kpi-foot-info">
            <% if !k.hideFoot: %>
              <span><%= k.footLabel %>: <b class="<% if k.outlier: %>is-warning<% end %>"><%= k.footValue %></b></span>
            <% end %>
            <% if k.outlier: %>
              <span class="team-kpi-chip is-warning js-kpi-tip" title="<%- @T('Rata-rata lebih dari 3× median: ada tiket yang lama tidak dibalas') %>"><%- @T('Ada outlier') %></span>
            <% end %>
          </span>
          <% if k.drill: %>
            <a href="#" class="team-kpi-drill js-kpi-drill" data-metric="<%= k.drill.metric %>"><%= k.drill.label %> →</a>
          <% end %>
        </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Rincian: nav-tabs kit di dalam card (pola invoice-list). Hanya panel tab %>
  <%# aktif yang dirender; datanya diambil saat tab dibuka (team_kpi.coffee). %>
  <div class="team-kpi-card team-kpi-detail">
    <div class="team-kpi-navtabs" role="tablist" aria-label="<%- @T('Rincian KPI') %>">
      <% for t in @tabs: %>
        <button type="button" role="tab" class="team-kpi-navtab js-kpi-tab <% if t.active: %>is-active<% end %>" data-tab="<%= t.key %>" aria-selected="<%= if t.active then 'true' else 'false' %>" aria-controls="kpi-pane-<%= t.key %>">
          <%= t.label %><% if t.badge: %><span class="team-kpi-tab-badge <%= t.badge.cls %> js-kpi-tip" title="<%= t.badge.tip %>" aria-label="<%= t.badge.tip %>"><%= t.badge.text %></span><% end %>
        </button>
      <% end %>
    </div>

    <% if @tab is 'trend': %>
      <div class="team-kpi-pane" id="kpi-pane-trend" role="tabpanel">
        <div class="team-kpi-section-head">
          <div>
            <div class="team-kpi-section-title">
              <%- @T('Tren per metrik') %>
              <span class="team-kpi-help js-kpi-tip" tabindex="0" title="<%- @T('Nilai per hari/minggu/bulan di periode terpilih (garis biru), dibanding periode pembanding (garis putus-putus). Arahkan kursor ke grafik untuk nilai per titik. Rasio Escalated dihitung dari snapshot per jam, jadi riwayatnya baru ada sejak snapshot mulai dikumpulkan.') %>"><%- @SiskaIcon('info', 14) %></span>
            </div>
            <div class="team-kpi-muted"><%= @trend.subtitle || @basis %></div>
          </div>
          <div class="team-kpi-btn-group" role="group" aria-label="<%- @T('Metrik tren') %>">
            <% for m in @trend.metrics: %>
              <button type="button" class="team-kpi-btn js-kpi-metric <% if m.active: %>is-active<% end %>" data-metric="<%= m.key %>" aria-pressed="<%= if m.active then 'true' else 'false' %>"><%= m.label %></button>
            <% end %>
          </div>
        </div>
        <% if @trend.empty: %>
          <div class="team-kpi-empty"><%- @SiskaIcon('info', 22) %><span><%= @trend.emptyText %></span></div>
        <% else: %>
          <div class="team-kpi-legend">
            <span><i class="is-current"></i><%- @T('Periode ini') %>: <b><%= @trend.curAvg %></b></span>
            <% if @trend.hasCmp: %>
              <span><i class="is-compare"></i><%= @trend.cmpLabel %>: <b><%= @trend.prevAvg %></b></span>
              <% if @trend.delta: %><span><b class="<%= @trend.delta.cls %>"><%= @trend.delta.text %></b></span><% end %>
            <% end %>
            <span class="team-kpi-muted"><%- @T('rata-rata per titik') %></span>
          </div>
          <div class="team-kpi-apex team-kpi-apex--trend js-kpi-trend-chart" role="img" aria-label="<%- @T('Grafik tren') %> <%= @trend.metricLabel %>"></div>
        <% end %>
      </div>

    <% else if @tab is 'load': %>
      <div class="team-kpi-pane" id="kpi-pane-load" role="tabpanel">
        <div class="team-kpi-section-head">
          <div>
            <div class="team-kpi-section-title"><%- @T('Beban tiket per jam') %></div>
            <div class="team-kpi-muted"><%- @T('Rata-rata tiket masuk per jam, %s · arahkan kursor untuk jumlah', @basis) %></div>
          </div>
          <% if @heatmap.state is 'ready': %>
            <div class="team-kpi-muted team-kpi-heat-note"><%- @T('Makin gelap = makin ramai') %> · <%- @T('maks') %> <b><%= @heatmap.max %></b> <%- @T('tiket/hari') %></div>
          <% end %>
        </div>
        <% if @heatmap.state is 'ready': %>
          <div class="team-kpi-apex team-kpi-apex--heat js-kpi-heat-chart" role="img" aria-label="<%- @T('Heatmap beban tiket per jam') %>"></div>
          <% if @heatmap.summary: %>
            <div class="team-kpi-heat-summary">
              <% for item in @heatmap.summary: %>
                <div>
                  <span><%= item.label %></span>
                  <b><%= item.value %></b>
                  <small><%= item.note %></small>
                  <% if item.note2: %><small class="is-nowrap"><%= item.note2 %></small><% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else if @heatmap.state is 'empty': %>
          <div class="team-kpi-empty"><%- @SiskaIcon('info', 22) %><span><%- @T('Belum ada tiket masuk di periode ini.') %></span></div>
        <% else if @heatmap.state is 'failed': %>
          <div class="team-kpi-empty"><span><%- @T('Gagal memuat heatmap. Coba lagi beberapa saat lagi.') %></span></div>
        <% else: %>
          <div class="team-kpi-empty"><span><%- @T('Memuat…') %></span></div>
        <% end %>
      </div>

    <% else if @tab is 'sla': %>
    <div class="team-kpi-pane team-kpi-pane--split team-kpi-pane--split3" id="kpi-pane-sla" role="tabpanel">
        <div class="team-kpi-bars">
          <div>
          <div class="team-kpi-section-title">
            <%- @T('FRT per help topic') %>
            <span class="team-kpi-help js-kpi-tip" tabindex="0" title="<%- @T('Persentase tiket yang respons pertamanya dalam target help topic-nya. Populasi, menit, dan target sama dengan kartu First Response Time.') %>"><%- @SiskaIcon('info', 14) %></span>
          </div>
          <div class="team-kpi-muted"><%- @T('Persentase tiket direspons dalam target help topic-nya, %s', @basis) %></div>
          </div>
          <% if @frtTopic: %>
            <%- @frtTopic.pctHtml %>
            <div class="team-kpi-sla-stats">
              <div><span><%- @T('Lewat target') %></span><b class="<% if @frtTopic.lateHot: %>is-bad<% end %>"><%= @frtTopic.late %></b></div>
              <% if @frtTopic.globalCount?: %>
                <div><span class="js-kpi-tip" title="<%- @T('Help topic tanpa target sendiri di Setting Target FRT per help topic') %>"><%- @T('Memakai target global') %></span><b><%= @frtTopic.globalCount %> <%- @T('topik') %></b></div>
              <% end %>
            </div>
            <div class="team-kpi-sla-rows">
              <% for row in @frtTopic.rows: %>
                <div class="team-kpi-meter-row">
                  <div class="team-kpi-bar-row-head"><span><%= row.label %> <small><%= row.target %> · n <%= row.total %> · <%= row.late %> <%- @T('lewat target') %></small></span><b class="is-<%= row.cls %>"><%= row.pctText %></b></div>
                  <div class="team-kpi-meter"><i class="is-<%= row.cls %>" style="width: <%= row.pct %>%"></i></div>
                </div>
              <% end %>
              <% if @frtTopic.more: %><span class="team-kpi-muted"><%= @frtTopic.more %></span><% end %>
            </div>
            <button type="button" class="team-kpi-link team-kpi-link--btn js-kpi-tab-link" data-tab="topic"><%- @T('Lihat semua help topic') %> →</button>
          <% else: %>
            <div class="team-kpi-empty"><span><%- @T('Belum ada tiket customer yang direspons di periode ini.') %></span></div>
          <% end %>
        </div>
        <div class="team-kpi-bars">
          <div>
          <div class="team-kpi-section-title">
            <%- @T('SLA penyelesaian') %>
            <span class="team-kpi-help js-kpi-tip" tabindex="0" title="<%- @T('Dari tiket yang closed di periode terpilih dan punya batas penyelesaian SLA, berapa persen yang closed tepat waktu. SLA respons pertama belum dikonfigurasi di sistem ini.') %>"><%- @SiskaIcon('info', 14) %></span>
          </div>
          <div class="team-kpi-muted"><%- @T('Persentase tiket closed tepat waktu per help topic (dimensi SLA), %s', @basis) %></div>
          </div>
          <% if @slaTotal: %>
            <%- @slaTotal.pctHtml %>
            <div class="team-kpi-sla-stats">
              <div><span><%- @T('Terlambat') %></span><b class="<% if @slaTotal.lateHot: %>is-bad<% end %>"><%= @slaTotal.late %></b></div>
              <div><span class="js-kpi-tip" title="<%- @T('Median berapa lama tiket yang terlambat melewati batas SLA-nya') %>"><%- @T('Median terlambat') %></span><b><%= @slaTotal.lateMed %></b></div>
            </div>
            <div class="team-kpi-sla-rows">
              <% for row in @sla.rows: %>
                <div class="team-kpi-meter-row">
                  <div class="team-kpi-bar-row-head"><span><%= row.label %> <small><% if row.target: %><%= row.target %> · <% end %>n <%= row.total %> · <%= row.late %> <%- @T('terlambat') %></small></span><b class="is-<%= row.cls %>"><%= row.pctText %></b></div>
                  <div class="team-kpi-meter"><i class="is-<%= row.cls %>" style="width: <%= row.pct %>%"></i></div>
                </div>
              <% end %>
              <% if @sla.more: %><span class="team-kpi-muted js-kpi-tip team-kpi-dotted" title="<%= @sla.moreTip %>"><%= @sla.more %></span><% end %>
            </div>
          <% else: %>
            <div class="team-kpi-empty"><span><%- @T('Belum ada tiket closed ber-SLA di periode ini.') %></span></div>
          <% end %>
        </div>
        <div class="team-kpi-bars">
          <div>
          <div class="team-kpi-section-title">
            <%- @T('Umur backlog') %>
            <span class="team-kpi-help js-kpi-tip" tabindex="0" title="<%- @T('Tiket yang belum closed, dikelompokkan menurut umurnya sejak dibuat. Real-time, tidak ikut filter periode.') %>"><%- @SiskaIcon('info', 14) %></span>
          </div>
          <div class="team-kpi-muted"><%- @T('Tiket belum closed menurut umur · real-time') %></div>
          </div>
          <% for row in @backlog: %>
            <div class="team-kpi-meter-row">
              <div class="team-kpi-bar-row-head"><span><%= row.label %></span><b class="<% if row.old: %>is-warning<% end %>"><%= row.count %></b></div>
              <div class="team-kpi-meter"><i class="<% if row.old: %>is-ok<% else: %>is-primary<% end %>" style="width: <%= row.pct %>%"></i></div>
            </div>
          <% end %>
          <a href="#ticket/view/all_open" class="team-kpi-link"><%- @T('Buka tiket aktif') %> →</a>
        </div>
    </div>

    <% else if @tab is 'topic': %>
      <div class="team-kpi-pane" id="kpi-pane-topic" role="tabpanel">
        <div class="team-kpi-section-head">
          <div>
            <div class="team-kpi-section-title"><%- @T('FRT & SLA per help topic') %></div>
            <div class="team-kpi-muted"><%= @topic.note %></div>
          </div>
          <% if !@topic.empty: %>
            <label class="team-kpi-select"><%- @T('Urutkan') %>
              <select class="js-kpi-topic-sort">
                <% for o in @topic.sorts: %><option value="<%= o.value %>" <% if o.selected: %>selected<% end %>><%= o.label %></option><% end %>
              </select>
            </label>
          <% end %>
        </div>
        <% if @topic.empty: %>
          <div class="team-kpi-empty"><span><%- @T('Belum ada tiket di periode ini.') %></span></div>
        <% else: %>
          <% if @topic.alert: %>
            <div class="team-kpi-banner is-warning team-kpi-topic-alert" role="note"><%- @SiskaIcon('warning', 16) %><span><b><%= @topic.alert.head %></b> <%= @topic.alert.list %>. <%- @T('Target sendiri bisa ditetapkan bersama pemilik layanan di Setting "Target FRT per help topic".') %></span></div>
          <% end %>
          <div class="team-kpi-table-wrap"><table class="team-kpi-table team-kpi-table--topic">
            <thead>
              <tr>
                <th rowspan="2"><%- @T('Help topic') %></th>
                <th colspan="5" class="is-group"><%- @T('First Response Time') %></th>
                <th colspan="3" class="is-group"><%- @T('SLA penyelesaian') %></th>
              </tr>
              <tr>
                <th class="is-sep"><%- @T('Target') %></th>
                <th class="is-num">n</th>
                <th class="is-num"><%- @T('Median') %></th>
                <th class="is-num"><%- @T('Sesuai target') %></th>
                <th class="is-num"><%- @T('vs pembanding') %></th>
                <th class="is-sep"><%- @T('Target') %></th>
                <th class="is-num"><%- @T('Closed') %></th>
                <th class="is-num"><%- @T('Tepat waktu') %></th>
              </tr>
            </thead>
            <tbody>
              <% for r in @topic.rows: %>
                <tr>
                  <td class="team-kpi-topic-name"><%= r.label %></td>
                  <% if r.frt: %>
                    <td class="is-sep"><%= r.frt.target %><% if r.frt.global: %> <span class="team-kpi-chip is-warning"><%- @T('global') %></span><% end %></td>
                    <td class="is-num"><%= r.frt.n %><% if r.frt.small: %> *<% end %></td>
                    <td class="is-num team-kpi-muted"><%= r.frt.median %></td>
                    <td class="is-num"><div class="team-kpi-inline-bar"><div class="team-kpi-meter"><i class="is-<%= r.frt.cls %>" style="width: <%= r.frt.pct %>%"></i></div><b class="is-<%= r.frt.cls %>"><%= r.frt.pctText %></b></div></td>
                    <td class="is-num"><% if r.frt.delta: %><b class="<%= r.frt.delta.cls %>"><%= r.frt.delta.text %></b><% else: %><span class="team-kpi-muted">—</span><% end %></td>
                  <% else: %>
                    <td colspan="5" class="is-sep team-kpi-muted is-center"><%- @T('tidak ada tiket dari customer') %></td>
                  <% end %>
                  <% if r.sla: %>
                    <td class="is-sep team-kpi-muted"><%= r.sla.target %></td>
                    <td class="is-num"><%= r.sla.n %><% if r.sla.small: %> *<% end %></td>
                    <td class="is-num"><div class="team-kpi-inline-bar"><div class="team-kpi-meter"><i class="is-<%= r.sla.cls %>" style="width: <%= r.sla.pct %>%"></i></div><b class="is-<%= r.sla.cls %>"><%= r.sla.pctText %></b></div></td>
                  <% else: %>
                    <td colspan="3" class="is-sep team-kpi-muted is-center">—</td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table></div>
          <div class="team-kpi-topic-foot">
            <span class="team-kpi-muted"><%- @T('* sampel kecil (n < 30) · warna = ambang Rasio Escalated atas % terlambat, sama dengan status kartu · vs pembanding dalam poin, hanya kalau kedua periode n ≥ 30') %></span>
            <% if @topic.smallCount: %>
              <button type="button" class="team-kpi-link team-kpi-link--btn js-kpi-topic-small" aria-pressed="<%= if @topic.showSmall then 'true' else 'false' %>"><% if @topic.showSmall: %><%- @T('Sembunyikan %s help topic kecil', @topic.smallCount) %><% else: %><%- @T('Tampilkan %s help topic kecil', @topic.smallCount) %><% end %></button>
            <% end %>
          </div>
        <% end %>
      </div>

    <% else if @tab is 'agents': %>
      <div class="team-kpi-pane" id="kpi-pane-agents" role="tabpanel">
        <div class="team-kpi-section-head">
          <div>
            <div class="team-kpi-section-title"><%- @T('Performa per agent') %></div>
            <div class="team-kpi-muted"><%- @T('Tiket = dibuat di periode (%s) · FRT milik pembalas pertama · Escalated & Breach real-time · hanya untuk Supervisor KPI/admin', @basis) %></div>
          </div>
        </div>
        <% if @agentsState is 'loading': %>
          <div class="team-kpi-empty"><span><%- @T('Memuat…') %></span></div>
        <% else if @agentsState is 'failed': %>
          <div class="team-kpi-empty"><span><%- @T('Gagal memuat data agent. Coba lagi beberapa saat lagi.') %></span></div>
        <% else if @agents: %>
          <% if @agents.length: %>
            <div class="team-kpi-table-wrap"><table class="team-kpi-table">
              <thead>
                <tr>
                  <th><%- @T('Agent') %></th>
                  <th class="is-wide"><%- @T('Tiket') %></th>
                  <th class="is-num"><%- @T('FRT median') %></th>
                  <th class="is-num"><%- @T('CSAT') %></th>
                  <th class="is-num"><%- @T('Escalated') %></th>
                  <th class="is-num"><%- @T('Breach') %></th>
                </tr>
              </thead>
              <tbody>
                <% for a in @agents: %>
                  <tr>
                    <td class="team-kpi-agent" title="<%= a.name %>"><span class="team-kpi-avatar <% if a.unassigned: %>is-muted<% end %>"><%= a.initials %></span><%= a.name %></td>
                    <td><div class="team-kpi-inline-bar"><div class="team-kpi-meter"><i style="width: <%= a.pct %>%"></i></div><b><%= a.tickets %></b></div></td>
                    <td class="is-num"><span class="js-kpi-tip team-kpi-dotted is-<%= a.frtCls %>" title="<%= a.frtTip %>"><%= a.frt %></span></td>
                    <td class="is-num"><span class="js-kpi-tip is-<%= a.csatCls %>" title="<%= a.csatTip %>"><%= a.csat %></span></td>
                    <td class="is-num"><%= a.escalated %></td>
                    <td class="is-num <% if a.breachHot: %>is-bad<% end %>"><%= a.breach %></td>
                  </tr>
                <% end %>
              </tbody>
            </table></div>
            <% if @agentsMore: %><div class="team-kpi-muted team-kpi-agents-more"><%= @agentsMore %></div><% end %>
          <% else: %>
            <div class="team-kpi-empty"><span><%- @T('Belum ada tiket yang ditangani di periode ini.') %></span></div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% end %>
</div>
