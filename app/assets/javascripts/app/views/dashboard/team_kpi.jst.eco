<div class="team-kpi-filter">
  <label><%- @T('Periode FRT & CSAT') %></label>
  <select class="js-kpi-range">
    <option value="7" <% if @selectedRange is 7: %>selected<% end %>><%- @T('7 hari') %></option>
    <option value="30" <% if @selectedRange is 30: %>selected<% end %>><%- @T('30 hari') %></option>
    <option value="90" <% if @selectedRange is 90: %>selected<% end %>><%- @T('90 hari') %></option>
    <option value="180" <% if @selectedRange is 180: %>selected<% end %>><%- @T('6 bulan') %></option>
    <option value="365" <% if @selectedRange is 365: %>selected<% end %>><%- @T('1 tahun') %></option>
    <option value="730" <% if @selectedRange is 730: %>selected<% end %>><%- @T('2 tahun') %></option>
  </select>
</div>
<div class="team-kpi-grid">
  <div class="team-kpi-card">
    <div class="team-kpi-title">
      <%- @T('First Response Time') %>
      <div class="team-kpi-help js-team-kpi-help" title="<%- @T('Median dan mean waktu respons pertama, dihitung dari periode yang dipilih. Mean jauh di atas median menandakan ada sejumlah kecil tiket yang direspons sangat lambat (long tail), tersembunyi kalau cuma melihat median.') %>" data-placement="bottom"><%- @Icon('help') %></div>
    </div>
    <div class="team-kpi-graphic">
      <%- @Icon('stopwatch', "team-kpi-icon team-kpi-icon--frt #{@frt_state_class}") %>
    </div>
    <div class="team-kpi-value-split">
      <div class="team-kpi-value-split-item">
        <div class="team-kpi-value-split-label"><%- @T('Median') %></div>
        <div class="team-kpi-value <%- @frt_state_class %>"><%- @frt_display %></div>
      </div>
      <div class="team-kpi-value-split-sep">|</div>
      <div class="team-kpi-value-split-item">
        <div class="team-kpi-value-split-label"><%- @T('Mean') %></div>
        <div class="team-kpi-value-secondary"><%- @frt_mean_display %></div>
      </div>
    </div>
    <div class="team-kpi-caption"><%- @T('%s hari terakhir', @window_days) %></div>
  </div>
  <div class="team-kpi-card">
    <div class="team-kpi-title">
      <%- @T('CSAT Score') %>
      <div class="team-kpi-help js-team-kpi-help" title="<%- @T('Rata-rata skor kepuasan customer (1-5), dari periode yang dipilih.') %>" data-placement="bottom"><%- @Icon('help') %></div>
    </div>
    <div class="team-kpi-graphic">
      <%- @Icon('thumbs-up', "team-kpi-icon team-kpi-icon--csat #{@csat_state_class}") %>
    </div>
    <div class="team-kpi-value <%- @csat_state_class %>"><%- @csat_display %></div>
    <div class="team-kpi-caption"><%- @T('rata-rata, %s hari terakhir', @window_days) %></div>
  </div>
  <div class="team-kpi-card">
    <div class="team-kpi-title">
      <%- @T('Tiket New') %>
      <div class="team-kpi-help js-team-kpi-help" title="<%- @T('Jumlah tiket berstatus New saat ini (realtime). Angka volume, tidak diberi indikator baik/buruk.') %>" data-placement="bottom"><%- @Icon('help') %></div>
    </div>
    <div class="team-kpi-graphic">
      <%- @Icon('email', 'team-kpi-icon team-kpi-icon--new') %>
    </div>
    <div class="team-kpi-value"><%- @ticket_new %></div>
    <div class="team-kpi-caption"><%- @T('saat ini') %></div>
  </div>
  <div class="team-kpi-card">
    <div class="team-kpi-title">
      <%- @T('Tiket Open') %>
      <div class="team-kpi-help js-team-kpi-help" title="<%- @T('Jumlah tiket berstatus Open saat ini (realtime). Angka volume, tidak diberi indikator baik/buruk.') %>" data-placement="bottom"><%- @Icon('help') %></div>
    </div>
    <div class="team-kpi-graphic">
      <%- @Icon('checklist', 'team-kpi-icon team-kpi-icon--open') %>
    </div>
    <div class="team-kpi-value"><%- @ticket_open %></div>
    <div class="team-kpi-caption"><%- @T('saat ini') %></div>
  </div>
  <div class="team-kpi-card">
    <div class="team-kpi-title">
      <%- @T('Tiket Escalated') %>
      <div class="team-kpi-help js-team-kpi-help" title="<%- @T('Persentase tiket New+Open yang sudah lewat SLA (realtime).') %>" data-placement="bottom"><%- @Icon('help') %></div>
    </div>
    <div class="team-kpi-graphic">
      <div class="team-kpi-icon team-kpi-icon-glyph <%- @escalated_state_class %>">!</div>
    </div>
    <div class="team-kpi-value <%- @escalated_state_class %>"><%- @ticket_escalated %></div>
    <div class="team-kpi-caption"><%- @T('saat ini, %s% dari New+Open', @escalation_rate_percent) %></div>
  </div>
  <div class="team-kpi-card">
    <div class="team-kpi-title">
      <%- @T('Tiket Breach Eskalasi') %>
      <div class="team-kpi-help js-team-kpi-help" title="<%- @T('Jumlah tiket berstatus Eskalasi yang sudah melewati batas waktu (escalation_deadline_at), dari total tiket berstatus Eskalasi saat ini (realtime).') %>" data-placement="bottom"><%- @Icon('help') %></div>
    </div>
    <div class="team-kpi-graphic">
      <div class="team-kpi-icon team-kpi-icon-glyph <%- @eskalasi_breach_state_class %>">!</div>
    </div>
    <div class="team-kpi-value <%- @eskalasi_breach_state_class %>"><%- @eskalasi_breached %></div>
    <div class="team-kpi-caption"><%- @T('saat ini, %s% dari %s tiket Eskalasi', @eskalasi_breach_rate_percent, @eskalasi_active) %></div>
  </div>
</div>
