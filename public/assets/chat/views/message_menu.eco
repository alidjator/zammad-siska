<!-- Menu bubble ala WhatsApp: gaya `.dropdown-menu` kit (radius 8,
bayangan kit, p-2), item `.dropdown-item` (ikon 18px, 14px). Isi per
jenis pesan: teks -> Reply + Copy; file/gambar -> Reply + Download.
Reply memakai `.js-message-reply` (handler `startReply` yg sudah ada). -->
<div class="zammad-chat-message-menu js-message-menu-list" role="menu" aria-label="<%- @T('Message options') %>">
  <button type="button" class="zammad-chat-message-menu-item js-message-reply" role="menuitem"><%- @icon('arrow-bend-up-left', 18) %><span><%- @T('Reply') %></span></button>
  <% if @kind is 'text': %>
  <button type="button" class="zammad-chat-message-menu-item js-message-copy" role="menuitem"><%- @icon('copy', 18) %><span><%- @T('Copy') %></span></button>
  <% else: %>
  <a class="zammad-chat-message-menu-item js-message-download" role="menuitem" href="<%= @download %>" download="<%= @filename %>" target="_blank" rel="noopener"><%- @icon('download-simple', 18) %><span><%- @T('Download') %></span></a>
  <% end %>
</div>
