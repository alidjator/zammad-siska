<!-- Fitur kirim gambar: placeholder SELAMA upload -- preview lokal (object
URL) diburamkan + spinner kit + persentase. Diganti bubble gambar asli
saat broadcast `chat_session_attachment` milik sendiri tiba
(`addAttachmentMessage`), dihapus kalau upload gagal. -->
<div class="zammad-chat-message zammad-chat-message--media zammad-chat-message--customer zammad-chat-message--uploading js-image-upload" data-upload-id="<%= @uploadId %>">
  <% if @avatar or @initials: %><span class="zammad-chat-message-avatar" aria-hidden="true"><% if @avatar: %><img src="<%= @avatar %>" alt=""><% else: %><%= @initials %><% end %></span><% end %>
  <span class="zammad-chat-message-main"><% if @author: %><span class="zammad-chat-message-author"><%= @author %></span><% end %><span class="zammad-chat-message-row"><span class="zammad-chat-message-body zammad-chat-image zammad-chat-image-card"><span class="zammad-chat-image-open zammad-chat-image-open--uploading"><img class="zammad-chat-image-thumb" src="<%= @previewUrl %>" alt=""><span class="zammad-chat-image-uploading" role="status"><span class="zammad-chat-image-spinner" aria-hidden="true"></span><span class="zammad-chat-sr-only"><%- @T('Uploading…') %></span></span></span><span class="zammad-chat-image-card-foot"><span class="zammad-chat-image-card-text"><span class="zammad-chat-image-card-name" title="<%= @filename %>"><%= @filename %></span><span class="zammad-chat-image-card-meta js-image-progress"><%- @T('Uploading…') %> 0%</span></span></span></span></span>
</span>
</div>
