<div class="zammad-chat-offline-compose">
  <div class="zammad-chat-offline-compose-verified">
    <%- @icon('check', 15) %>
    <span><strong><%= @email %></strong> <%- @T(@phrases['chat_phrase_offline_compose_verified_suffix'] || 'verified') %></span>
  </div>

  <!-- Subject DIPINDAH ke prechat (views/prechat.eco) atas permintaan
  user -- form ini tinggal isi pesan (deskripsi) saja. -->
  <label class="zammad-chat-offline-compose-label"><%- @T(@phrases['chat_phrase_offline_compose_message_label'] || 'Your message') %></label>
  <textarea class="zammad-chat-offline-compose-textarea js-offline-message" placeholder="<%- @T(@phrases['chat_phrase_offline_compose_placeholder'] || 'Tell us how we can help…') %>"></textarea>

  <div class="zammad-chat-offline-compose-error js-offline-compose-error zammad-chat-is-hidden"></div>

  <!-- Item lampiran (follow-up terpisah dari Enhancement 4 awal).
  Diisi dinamis lewat JS (`onOfflineAttachmentUploaded`) -- kosong
  by default, TIDAK ADA tombol hapus (endpoint DELETE tidak ada di
  manapun di codebase ini, konsisten dgn attachment chat biasa yang
  juga fire-and-forget/tidak bisa dibatalkan). -->
  <div class="zammad-chat-offline-compose-attachments js-offline-compose-attachments"></div>

  <button type="button" class="zammad-chat-offline-compose-attach js-offline-compose-attach">
    <%- @icon('paperclip', 16) %>
    <span><%- @T(@phrases['chat_phrase_offline_compose_attach_button'] || 'Add attachment') %></span>
  </button>
  <input type="file" class="js-offline-compose-attachment-input zammad-chat-is-hidden">

  <button type="button" class="zammad-chat-offline-compose-submit js-offline-compose-submit"><%- @T(@phrases['chat_phrase_offline_compose_send_button'] || 'Send Message') %></button>
</div>
