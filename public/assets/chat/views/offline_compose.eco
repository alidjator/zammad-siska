<div class="zammad-chat-offline-compose">
  <div class="zammad-chat-offline-compose-verified">
    <svg width="15" height="15" viewBox="0 0 1010 986.5" fill="currentColor"><g transform="scale(1,-1) translate(0,-986.5)"><path d="M845 650C832.237 650 825.686 646.124 818 641C815 639 726 550 620 444L427 251L335 343C256 422 242 435 237 437C226.703 440.433 210.034 444.356 199 437C190.706 432.854 184.839 424.259 180 417C177 412 178 411 178 400S177 388 180 382C185.88 372.2000000000001 396.996 159.145 409 154C415 151 418 150 424 150C436.133 150 440.926 152.463 448 156C451.27 158.18 872.944 576.9159999999999 877 583C882.59 590.453 885 599.9300000000001 885 611C885 631.797 865.878 650 845 650z"/></g></svg>
    <span><strong><%= @email %></strong> <%- @T(@phrases['chat_phrase_offline_compose_verified_suffix'] || 'verified') %></span>
  </div>

  <!-- Atas permintaan user ("saya mau menambahkan subject, dan subject
  ini mandatory") -- subject WAJIB diisi (divalidasi frontend & backend,
  lihat `submitOfflineMessage`/`chat_offline_message_send.rb`), dipakai
  jadi JUDUL tiket yang dibuat otomatis (bukan lagi "Live Chat -
  [nama]" generik, lihat `Chat::Session#create_ticket_for_chat!`). -->
  <label class="zammad-chat-offline-compose-label"><%- @T(@phrases['chat_phrase_offline_compose_subject_label'] || 'Subject') %></label>
  <input type="text" class="zammad-chat-offline-compose-subject-input js-offline-subject" placeholder="<%- @T(@phrases['chat_phrase_offline_compose_subject_placeholder'] || "What's this about?") %>">

  <label class="zammad-chat-offline-compose-label zammad-chat-offline-compose-label--spaced"><%- @T(@phrases['chat_phrase_offline_compose_message_label'] || 'Your message') %></label>
  <textarea class="zammad-chat-offline-compose-textarea js-offline-message" placeholder="<%- @T(@phrases['chat_phrase_offline_compose_placeholder'] || 'Tell us how we can help…') %>"></textarea>

  <div class="zammad-chat-offline-compose-error js-offline-compose-error zammad-chat-is-hidden"></div>

  <!-- Item lampiran (follow-up terpisah dari Enhancement 4 awal).
  Diisi dinamis lewat JS (`onOfflineAttachmentUploaded`) -- kosong
  by default, TIDAK ADA tombol hapus (endpoint DELETE tidak ada di
  manapun di codebase ini, konsisten dgn attachment chat biasa yang
  juga fire-and-forget/tidak bisa dibatalkan). -->
  <div class="zammad-chat-offline-compose-attachments js-offline-compose-attachments"></div>

  <button type="button" class="zammad-chat-offline-compose-attach js-offline-compose-attach">
    <svg width="16" height="16" viewBox="0 0 1010 986.5" fill="currentColor"><g transform="scale(1,-1) translate(0,-986.5)"><path d="M640 826C612.498 826 594.654 824.885 574 818C552.419 810.807 530.815 803.452 514 790C509 786 499 780 494 775S420 702 341 623S195 476 191 472S181 460 177 454L163 433C149.85 413.276 141.325 394.302 135 369C126.589 335.355 121 320.855 121 275C121 198.2480000000001 141.429 149.857 172 104C194.018 70.975 222.565 44.168 255 21C300.382 -11.4159999999999 358.4220000000001 -32 436 -32C464.633 -32 482.888 -27.604 506 -21C552.83 -7.62 591.358 12.799 624 40C637.804 51.503 920.221 334.051 923 341C932.803 370.41 916.606 400 885 400C877.677 400 868.98 396.49 864 394C853.687 387.124 590.779 119.3340000000001 561 97C525.085 73.057 486.773 52 426 52C385.586 52 357.105 61.526 328 74C321 77 311 85 304 89C275.162 105.479 252.745 131.092 236 159C216.305 191.826 199.567 236.809 204 290C210.6 342.794 227.922 382.563 253 416C256 420 322 487 399 564S543 708 548 712C572.413 731.53 597.17 743 640 743C672.355 743 691.9 731.66 713 719C718 716 725 708 730 703C744.986 688.014 752.255 673.491 762 654C768.402 641.194 769 628.6700000000001 769 608C769 571.506 760.835 556.059 747 533C736.34 515.946 456.91 239.273 452 236C444.903 231.27 438.116 229 427 229C393.809 229 368.386 262.7720000000001 385 296C393.507 313.0130000000001 668.4069999999999 579.519 673 591C682.803 620.4100000000001 666.606 650 635 650C626.297 650 617.928 646.952 612 643C607.125 639.75 329.587 364.9390000000001 319 348C306.352 326.92 297 308.968 297 275C297 213.865 329.454 182.1280000000001 368 159C383.642 149.615 399.041 145 422 145C452.82 145 471.474 151.736 492 162C496 164 502 170 506 173S579 243 658 322S803 469 806 473C831.542 507.056 853 548.49 853 608C853 688.4970000000001 817.528 744.104 771 779C767 782 759 789 754 792C722.71 810.773 689.264 826 640 826z"/></g></svg>
    <span><%- @T(@phrases['chat_phrase_offline_compose_attach_button'] || 'Add attachment') %></span>
  </button>
  <input type="file" class="js-offline-compose-attachment-input zammad-chat-is-hidden">

  <button type="button" class="zammad-chat-offline-compose-submit js-offline-compose-submit"><%- @T(@phrases['chat_phrase_offline_compose_send_button'] || 'Send Message') %></button>
</div>
