<div class="zammad-chat-feedback-thanks">
  <div class="zammad-chat-feedback-thanks-icon">
    <%- @icon('check-circle', 30, tone: 'full') %>
  </div>
  <div class="zammad-chat-feedback-thanks-title"><%- @T(@phrases['chat_phrase_feedback_thanks_title'] || 'Thank you for your feedback!') %></div>
  <div class="zammad-chat-feedback-thanks-subtitle"><%- @T(@phrases['chat_phrase_feedback_thanks_subtitle'] || 'We appreciate you taking the time.') %></div>
</div>
