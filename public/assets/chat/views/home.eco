<div class="zammad-chat-home">
  <div class="zammad-chat-home-logo">
    <div class="zammad-chat-home-logo-mark">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H9l-4 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/></svg>
    </div>
    <span class="zammad-chat-home-logo-text">SISKA</span>
  </div>
  <div class="zammad-chat-home-actions">
    <button type="button" class="zammad-chat-home-action" data-tab="messages">
      <span><%- @T('Send us a message') %></span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
    </button>
    <button type="button" class="zammad-chat-home-action zammad-chat-home-action--secondary" data-tab="help">
      <span><%- @T('Search for help') %></span>
    </button>
  </div>
</div>
