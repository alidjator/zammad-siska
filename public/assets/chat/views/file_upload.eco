<!-- Permintaan user ("upload file attachment ada progressnya juga seperti
upload gambar"): placeholder kartu file SELAMA upload -- nama file,
persentase, progress bar tipis gaya `bc_progress.html` kit (track
bodybg, bar primary-500 rounded-lg, role="progressbar"). Diganti kartu
file asli DI POSISINYA saat broadcast `chat_session_attachment` milik
sendiri tiba (`addAttachmentMessage`), dihapus kalau upload gagal. -->
<div class="zammad-chat-message zammad-chat-message--customer zammad-chat-message--uploading js-file-upload" data-upload-id="<%= @uploadId %>">
  <span class="zammad-chat-message-row"><span class="zammad-chat-message-body zammad-chat-attachment"><span class="zammad-chat-attachment-row"><span class="zammad-chat-attachment-icon"><%- @icon('paperclip', 20, tone: 'full') %></span><span class="zammad-chat-attachment-info"><span class="zammad-chat-attachment-filename"><%= @filename %></span><span class="zammad-chat-attachment-meta js-upload-progress-text"><%- @T('Uploading…') %> 0%</span></span></span><span class="zammad-chat-upload-progress"><span class="zammad-chat-upload-progress-bar js-upload-progress-bar" role="progressbar" aria-label="<%- @T('Upload progress') %>" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></span></span></span></span>
</div>
