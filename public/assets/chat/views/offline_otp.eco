<div class="zammad-chat-offline-otp">
  <div class="zammad-chat-offline-otp-icon">
    <%- @icon('lock', 26, tone: 'full') %>
  </div>
  <div class="zammad-chat-offline-otp-title"><%- @T(@phrases['chat_phrase_otp_title'] || 'Enter verification code') %></div>
  <div class="zammad-chat-offline-otp-subtitle"><%- @T(@phrases['chat_phrase_otp_subtitle_prefix'] || 'We sent a 6-digit code to') %> <strong><%= @email %></strong>.</div>

  <div class="zammad-chat-offline-otp-boxes">
    <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" placeholder="0" class="zammad-chat-offline-otp-digit js-otp-digit" data-index="0">
    <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" placeholder="0" class="zammad-chat-offline-otp-digit js-otp-digit" data-index="1">
    <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" placeholder="0" class="zammad-chat-offline-otp-digit js-otp-digit" data-index="2">
    <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" placeholder="0" class="zammad-chat-offline-otp-digit js-otp-digit" data-index="3">
    <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" placeholder="0" class="zammad-chat-offline-otp-digit js-otp-digit" data-index="4">
    <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" placeholder="0" class="zammad-chat-offline-otp-digit js-otp-digit" data-index="5">
  </div>

  <div class="zammad-chat-offline-otp-error js-otp-error zammad-chat-is-hidden">
    <%- @icon('clock', 14) %>
    <span class="js-otp-error-text"></span>
  </div>

  <button type="button" class="zammad-chat-offline-otp-submit js-otp-submit"><%- @T(@phrases['chat_phrase_otp_verify_button'] || 'Verify') %></button>

  <div class="zammad-chat-offline-otp-resend">
    <span><%- @T(@phrases['chat_phrase_otp_resend_question'] || "Didn't receive the code?") %></span>
    <button type="button" class="zammad-chat-offline-otp-resend-btn js-otp-resend"><%- @T(@phrases['chat_phrase_otp_resend_button'] || 'Resend code') %></button>
  </div>

  <button type="button" class="zammad-chat-offline-otp-change-email js-otp-change-email"><%- @T(@phrases['chat_phrase_otp_change_email'] || 'Change email address') %></button>
</div>
