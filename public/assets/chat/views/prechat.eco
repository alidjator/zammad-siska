<div class="zammad-chat-modal-text">
  <form class="zammad-chat-prechat-form">
    <% if @error: %>
      <div class="zammad-chat-prechat-error"><%- @error %></div>
    <% end %>
    <input type="text" class="zammad-chat-prechat-name" placeholder="<%- @T('Your name') %>" value="<%- @name || '' %>" required>
    <input type="email" class="zammad-chat-prechat-email" placeholder="<%- @T('Your email') %>" value="<%- @email || '' %>" required>
    <button type="submit" class="zammad-chat-button zammad-chat-prechat-submit"<%= " style='background: #{ @background }'" if @background %>><%- @T('Start chat') %></button>
  </form>
</div>
