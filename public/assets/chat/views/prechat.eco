<div class="zammad-chat-prechat">
  <div class="zammad-chat-prechat-icon">
    <svg width="24" height="24" viewBox="0 0 1010 986.5" fill="currentColor"><g transform="scale(1,-1) translate(0,-986.5)"><path d="M508 734C622 734 722 733 729 733C774.723 733 809.074 710.9259999999999 833 687C859.828 660.172 876.365 631.81 884 586C885 578 885 538 885 435C885 295 884 294 882 284C879.283 267.697 875.055 256.0950000000001 867 242C863 235 859 225 855 220S845 208 841 204L826 189C811.787 174.787 790.124 166.05 770 158C765 156 756 154 750 153L740 150H360L280 70C216 6 199 -10 195 -12C188.312 -14.23 179.812 -17.963 170 -16L158 -12C147.402 -8.468 140.902 4.196 136 14V588L138 599C144.428 637.565 164.03 665.03 187 688C202.605 703.605 218.262 713.754 240 721C256.766 726.5889999999999 268.4700000000001 733 290 733C296 733 394 734 508 734zM514 650C394 650 294 649 293 649C278.984 649 266.013 642.76 257 636C248.29 629.4680000000001 239.776 624.664 234 616C227.679 606.519 224.068 596.204 220 584L219 355V127L269 177C312 220 320 227 325 229C328 230 334 232 338 233S416 234 537 234C725 234 730 234 738 236C754.136 239.228 767.266 248.266 777 258C786.451 267.451 795.835 281.1760000000001 799 297C801 305 801 309 801 445L800 584C788.876 617.373 771.835 636.722 738 648C732 650 717 650 514 650zM509 567C630 567 681 567 685 566C694.374 562.875 700.423 559.577 707 553C710 550 714 546 715 543C718.89 531.328 719.071 519.213 715 507C711.268 495.802 696.382 487.794 685 484C681 483 631 483 510 483S339 483 335 484C325.626 487.125 319.577 490.423 313 497C310 500 306 504 305 507C301.11 518.672 300.929 530.787 305 543C308.71 554.134 322.7440000000001 562.248 334 566C338 567 379 567 509 567zM468 400C342 400 337 400 331 398C317.32 393.44 302 381.472 302 364C301 360 301 356 302 352L306 340C310.293 327.121 324.266 320.434 338 317C342 316 392 316 468 316C536 316 596 317 599 317C619.693 317 635 337.231 635 358C635 380.3160000000001 621.969 392.344 605 398C600 399 586 400 468 400z"/></g></svg>
  </div>
  <div class="zammad-chat-prechat-title"><%- @T(@phrases['chat_phrase_prechat_title'] || 'Let\'s get started') %></div>
  <div class="zammad-chat-prechat-subtext"><%- @T(@phrases['chat_phrase_prechat_subtitle'] || 'Please share a few details so our agent can help you faster.') %></div>

  <form class="zammad-chat-prechat-form">
    <% if @error: %>
      <div class="zammad-chat-prechat-error"><%- @error %></div>
    <% end %>
    <!-- Notice BUKAN error (kabar baik, mis. "agent sekarang
    tersedia"), TERPISAH dari `.zammad-chat-prechat-error` (tetap
    merah, dipakai pesan gagal validasi sungguhan). Atas permintaan
    user (audit kit Able Pro TAILWIND baru): pola alert diganti ke
    `.alert-success` GENUINE kit baru (lihat chat.scss, sama dgn
    notice Home). Ikon centang stroke lama diganti Tabler
    `circle-check` (diekstrak+diverifikasi dgn cara sama spt ikon
    Home). -->
    <% if @notice: %>
      <div class="zammad-chat-prechat-notice">
        <svg width="16" height="16" viewBox="0 0 1010 986.5" fill="currentColor"><g transform="scale(1,-1) translate(0,-986.5)"><path d="M518 816C530 816 545 816 553 815C677.367 799.454 765.015 742.816 830 667C875.205 614.26 904.582 551.09 921 469C926.277 442.611 926 432.576 926 400C926 324.03 909.781 267.562 884 216C864.868 177.736 844.6610000000001 145.6610000000001 816 117L793 94C772.933 73.933 750.076 57.33 725 43C666.595 9.625 602.028 -16 510 -16C471.821 -16 449.486 -15.425 420 -7C384.66 3.098 357.568 10.216 326 26C287.736 45.132 255.661 65.3389999999999 227 94L204 117C190.573 130.427 177.435 148.348 167 164C125.575 226.137 94 296.337 94 400C94 460.342 104.183 499.549 119 544C121 550 124 560 127 566L140 592C170.252 652.504 214.535 700.812 268 739C316.793 773.852 374.601 801.657 447 812C459.05 813.722 477.947 816 490 816H518zM508 733C497 733 484 732 479 732C445.765 732 413.549 718.85 387 710C360 701 326.705 678.528 306 663C275.306 639.98 248.682 608.523 227 576C208.395 548.094 197.195 515.685 187 480C179.855 454.994 177 431.92 177 400C177 358.342 183.768 329.314 193 297C195 290 200 280 202 274C215.732 232.802 241.187 202.775 266 173C276.0950000000001 160.886 294.086 145.936 306 137C329.264 119.552 364.57 99.612 394 87C401 84 413 82 419 80C432.854 75.382 451.407 72.5990000000001 467 70C473 69 488 67 500 67C556.137 67 597.623 75.85 638 92C716.753 123.501 770.0889999999999 180.664 809 252C814 262 820 277 823 284S828 303 830 309C834.618 322.8540000000001 837.401 341.4070000000001 840 357C841 363 843 378 843 390C843 436.9 838.86 469.707 826 504C811.55 542.533 797.363 573.796 774 603C749.429 633.7139999999999 719.59 660.606 686 683C657.835 701.7760000000001 626.066 712.6949999999999 590 723C564.121 730.395 541.37 733 508 733zM634 525C625.33 525 620.683 522.842 615 520C612 518 590 497 540 447L468 376L440 405C416 429 409 434 404 437C395.056 442.963 375.352 443.234 366 437C352.93 428.287 332.651 404.023 348 381C351 376 358 368 397 329C424 302 444 283 447 281C454.026 277.487 458.9 275 471 275C476 275 481 277 485 279C495.528 284.265 665.924 453.873 672 464C690.61 491.915 661.99 525 634 525z"/></g></svg>
        <span><%- @notice %></span>
      </div>
    <% end %>
    <!-- Atas permintaan user ("saya mau menambahkan kategori ini pada
    halaman messages, sejalan dengan inputan name, email"): field
    wajib diisi, gaya & tinggi identik dgn Name/Email di bawah.
    Ditaruh PALING ATAS (urutan Category -> Name -> Email, atas
    permintaan user) -- BUKAN <select> native, widget ini konsisten
    pakai kontrol custom (pola sama dgn emoji-picker) supaya gaya Able
    Pro genuinely terpasang (select native tidak bisa di-skin lintas-
    browser). Isi pilihan (.js-prechat-category-menu) SENGAJA kosong
    di sini, dipopulasi via JS dari @categoryOptions
    (chat-no-jquery.coffee, showPrechatForm) -- pola SAMA dgn
    `.zammad-chat-kb-results` (views/help.eco) yg jg dipopulasi via
    JS, bukan loop di eco. -->
    <div class="zammad-chat-prechat-field zammad-chat-prechat-field--category">
      <label><%- @T(@phrases['chat_phrase_prechat_category_label'] || 'Category') %></label>
      <button type="button" class="zammad-chat-prechat-category js-prechat-category-toggle<%= ' zammad-chat-field-invalid' if @error and !@category %>" aria-expanded="false">
        <span class="zammad-chat-prechat-category-value js-prechat-category-value<%= ' is-placeholder' if !@category %>"><%- @T(@phrases['chat_phrase_prechat_category_placeholder'] || 'Select a category') %></span>
        <svg class="zammad-chat-prechat-category-chevron" width="16" height="16" viewBox="0 0 1010 986.5" fill="currentColor"><g transform="scale(1,-1) translate(0,-986.5)"><path d="M259 567C235.564 567 213.687 544.5640000000001 219 518C220 514 221 509 223 506C232.459 490.235 479.177 245.0940000000001 491 238C501.756 230.8300000000001 517.81 234.27 529 238C538.213 241.6860000000001 791.3009999999999 496.501 797 506C810.366 526.05 794.566 556.812 779 562C768.606 565.4649999999999 751.99 569.326 741 562C736 559 721 546 622 447L510 335L397 447C300 544 284 560 279 562C273.193 563.9359999999999 266.477 567 259 567z"/></g></svg>
      </button>
      <input type="hidden" class="js-prechat-category-input" value="<%- @category || '' %>">
      <div class="zammad-chat-prechat-category-menu js-prechat-category-menu zammad-chat-is-hidden"></div>
    </div>
    <div class="zammad-chat-prechat-field">
      <label><%- @T(@phrases['chat_phrase_prechat_name_label'] || 'Your name') %></label>
      <input type="text" class="zammad-chat-prechat-name<%= ' zammad-chat-field-invalid' if @error and !@name %>" value="<%- @name || '' %>" required>
    </div>
    <div class="zammad-chat-prechat-field">
      <label><%- @T(@phrases['chat_phrase_prechat_email_label'] || 'Your email') %></label>
      <input type="email" class="zammad-chat-prechat-email<%= ' zammad-chat-field-invalid' if @error and !@email %>" value="<%- @email || '' %>" required>
    </div>
    <!-- Atas permintaan user ("hilangkan icon pada button Start
    Chat"): ikon paper-plane dihapus, teks polos saja. -->
    <button type="submit" class="zammad-chat-prechat-submit">
      <span><%- @T(@phrases['chat_phrase_prechat_submit_button'] || 'Start chat') %></span>
    </button>
  </form>
</div>
