<div class="zammad-chat-prechat">
  <div class="zammad-chat-prechat-icon">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22.81C11.31 22.81 10.66 22.46 10.2 21.85L8.7 19.85C8.67 19.81 8.55 19.76 8.5 19.75H8C3.83 19.75 1.25 18.62 1.25 13V8C1.25 3.58 3.58 1.25 8 1.25H16C20.42 1.25 22.75 3.58 22.75 8V13C22.75 17.42 20.42 19.75 16 19.75H15.5C15.42 19.75 15.35 19.79 15.3 19.85L13.8 21.85C13.34 22.46 12.69 22.81 12 22.81ZM8 2.75C4.42 2.75 2.75 4.42 2.75 8V13C2.75 17.52 4.3 18.25 8 18.25H8.5C9.01 18.25 9.59 18.54 9.9 18.95L11.4 20.95C11.75 21.41 12.25 21.41 12.6 20.95L14.1 18.95C14.43 18.51 14.95 18.25 15.5 18.25H16C19.58 18.25 21.25 16.58 21.25 13V8C21.25 4.42 19.58 2.75 16 2.75H8Z"/><path d="M17 8.75H7C6.59 8.75 6.25 8.41 6.25 8C6.25 7.59 6.59 7.25 7 7.25H17C17.41 7.25 17.75 7.59 17.75 8C17.75 8.41 17.41 8.75 17 8.75Z"/><path d="M13 13.75H7C6.59 13.75 6.25 13.41 6.25 13C6.25 12.59 6.59 12.25 7 12.25H13C13.41 12.25 13.75 12.59 13.75 13C13.75 13.41 13.41 13.75 13 13.75Z"/></svg>
  </div>
  <div class="zammad-chat-prechat-title"><%- @T(@phrases['chat_phrase_prechat_title'] || 'Let\'s get started') %></div>
  <div class="zammad-chat-prechat-subtext"><%- @T(@phrases['chat_phrase_prechat_subtitle'] || 'Please share a few details so our agent can help you faster.') %></div>

  <form class="zammad-chat-prechat-form">
    <% if @error: %>
      <div class="zammad-chat-prechat-error"><%- @error %></div>
    <% end %>
    <!-- Atas permintaan user: notice BUKAN error (kabar baik, mis.
    "agent sekarang tersedia") pakai gaya notice SUKSES Able Pro
    (outline hijau), TERPISAH dari `.zammad-chat-prechat-error` (tetap
    merah, dipakai pesan gagal validasi sungguhan). -->
    <% if @notice: %>
      <div class="zammad-chat-prechat-notice">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m7.75 12 2.83 2.83 5.67-5.66"/></svg>
        <span><%- @notice %></span>
      </div>
    <% end %>
    <div class="zammad-chat-prechat-field">
      <label><%- @T(@phrases['chat_phrase_prechat_name_label'] || 'Your name') %></label>
      <input type="text" class="zammad-chat-prechat-name" value="<%- @name || '' %>" required>
    </div>
    <div class="zammad-chat-prechat-field">
      <label><%- @T(@phrases['chat_phrase_prechat_email_label'] || 'Your email') %></label>
      <input type="email" class="zammad-chat-prechat-email" value="<%- @email || '' %>" required>
    </div>
    <button type="submit" class="zammad-chat-prechat-submit">
      <span><%- @T(@phrases['chat_phrase_prechat_submit_button'] || 'Start chat') %></span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m9.51 4.23 8.56 4.28c3.84 1.92 3.84 5.06 0 6.98l-8.56 4.28c-5.76 2.88-8.11.52-5.23-5.23l.87-1.73c.22-.44.22-1.17 0-1.61l-.87-1.74C1.4 3.71 3.76 1.35 9.51 4.23ZM5.44 12h5.4"/></svg>
    </button>
  </form>
</div>
