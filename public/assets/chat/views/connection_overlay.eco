<% if @state is 'reconnecting': %>
  <!-- Audit kit Tailwind: spinner satu elemen (lihat chat.scss) +
  `role="status"`/`sr-only` spt spinner Waiting/EndingChat. -->
  <div class="zammad-chat-connection-overlay-spinner" role="status">
    <span class="zammad-chat-sr-only"><%- @T('Loading...') %></span>
  </div>
<% else if @state is 'restored': %>
  <div class="zammad-chat-connection-overlay-icon">
    <%- @icon('check-circle', 56, tone: 'full') %>
  </div>
<% else: %>
  <div class="zammad-chat-connection-overlay-icon">
    <%- @icon('x-circle', 56, tone: 'full') %>
  </div>
<% end %>

<div class="zammad-chat-connection-overlay-title"><%= @title %></div>
<% if @subtitle: %>
  <div class="zammad-chat-connection-overlay-subtitle"><%= @subtitle %></div>
<% end %>
<% if @state is 'lost': %>
  <button type="button" class="zammad-chat-connection-overlay-reload js-connection-reload"><%- @T('Reload page') %></button>
<% end %>
