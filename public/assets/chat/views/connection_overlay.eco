<% if @state is 'reconnecting': %>
  <!-- Audit kit Tailwind: spinner satu elemen (lihat chat.scss) +
  `role="status"`/`sr-only` spt spinner Waiting/EndingChat. -->
  <div class="zammad-chat-connection-overlay-spinner" role="status">
    <span class="zammad-chat-sr-only"><%- @T('Loading...') %></span>
  </div>
<% else if @state is 'restored': %>
