<!-- Menu bubble ala WhatsApp (mockup "Menu bubble ala WhatsApp"): ikon reply
samping bubble diganti tombol panah DI DALAM bubble (pesan agent ber-id)
yg membuka dropdown (views/message_menu.eco, `openMessageMenu`). -->
<div class="zammad-chat-message zammad-chat-message--<%= @from %><%= @unreadClass %>"<% if @id: %> data-message-id="<%= @id %>"<% end %>>
  <% if @avatar or @initials: %><span class="zammad-chat-message-avatar" aria-hidden="true"><% if @avatar: %><img src="<%= @avatar %>" alt=""><% else: %><%= @initials %><% end %></span><% end %>
  <span class="zammad-chat-message-main"><% if @author: %><span class="zammad-chat-message-author"><%= @author %></span><% end %><span class="zammad-chat-message-row"><span class="zammad-chat-message-body zammad-chat-attachment"><span class="zammad-chat-attachment-row"><span class="zammad-chat-attachment-icon zammad-chat-attachment-icon--<%= @fileTone(@filename) %>"><%- @icon(@fileIcon(@filename), 20, tone: 'full') %></span><span class="zammad-chat-attachment-info"><span class="zammad-chat-attachment-filename"><%= @filename %></span><% if @metaLabel: %><span class="zammad-chat-attachment-meta"><%= @metaLabel %></span><% end %></span><a href="<%= @url %>?disposition=attachment" download="<%= @filename %>" class="zammad-chat-attachment-download js-attachment-download" target="_blank" rel="noopener" aria-label="<%- @T('Download') %>"><%- @icon('download-simple', 16) %></a></span><span class="zammad-chat-message-time"><%= @time %><% if @from is 'customer': %><span class="zammad-chat-message-status zammad-chat-message-status--<%= if @isRead then 'read' else 'sent' %>" aria-label="<%- if @isRead then @T('Read') else @T('Sent') %>"><%- @icon('checks', 16) %></span><% end %></span><% if @id: %><button type="button" class="zammad-chat-message-menu-toggle js-message-menu" aria-label="<%- @T('Message options') %>" aria-haspopup="menu" aria-expanded="false" data-kind="file" data-download="<%= @url %>?disposition=attachment" data-filename="<%= @filename %>"><%- @icon('caret-down', 16) %></button><% end %></span></span>
</span>
</div>
