<div class="zammad-chat-message zammad-chat-message--<%= @from %><%= @unreadClass %>"<% if @id: %> data-message-id="<%= @id %>"<% end %>>
  <span class="zammad-chat-message-row"><span class="zammad-chat-message-body zammad-chat-attachment"><span class="zammad-chat-attachment-row"><span class="zammad-chat-attachment-icon"><%- @icon('paperclip', 20, tone: 'full') %></span><span class="zammad-chat-attachment-info"><span class="zammad-chat-attachment-filename"><%= @filename %></span><% if @metaLabel: %><span class="zammad-chat-attachment-meta"><%= @metaLabel %></span><% end %></span><a href="<%= @url %>?disposition=attachment" download="<%= @filename %>" class="zammad-chat-attachment-download js-attachment-download" target="_blank" rel="noopener" aria-label="<%- @T('Download') %>"><%- @icon('download-simple', 16) %></a></span><span class="zammad-chat-message-time"><%= @time %><% if @from is 'customer': %><span class="zammad-chat-message-status zammad-chat-message-status--<%= if @isRead then 'read' else 'sent' %>" aria-label="<%- if @isRead then @T('Read') else @T('Sent') %>"><%- @icon('checks', 16) %></span><% end %></span></span><% if @from is 'agent' and @id: %><button type="button" class="zammad-chat-message-reply js-message-reply" aria-label="<%- @T('Reply') %>"><%- @icon('arrow-bend-up-left', 14) %></button><% end %></span>
</div>
