<div class="zammad-chat<%= ' zammad-chat--flat' if @flat %>"<%= " style='font-size: #{ @fontSize }'" if @fontSize %>>
  <div class="zammad-chat-header">
    <div class="zammad-chat-agent zammad-chat-is-hidden">
    </div>
    <div class="zammad-chat-welcome">
      <span class="zammad-chat-welcome-title"><%- @T(@phrases['chat_phrase_home_greeting'] || 'Hi there') %> 👋</span>
      <span class="zammad-chat-welcome-subtext"><%- @T(@phrases['chat_phrase_home_subtitle'] || 'How can we help you today?') %></span>
    </div>
    <div class="zammad-chat-header-title zammad-chat-is-hidden"><span class="js-header-title-text"></span></div>
    <div class="zammad-chat-header-controls">
      <button type="button" class="zammad-chat-header-icon zammad-chat-header-icon-minimize js-chat-minimize" aria-label="<%- @T('Minimize') %>">
        <svg width="17" height="17" viewBox="0 0 1010 986.5" fill="currentColor"><g transform="scale(1,-1) translate(0,-986.5)"><path d="M259 567C235.564 567 213.687 544.5640000000001 219 518C220 514 221 509 223 506C232.459 490.235 479.177 245.0940000000001 491 238C501.756 230.8300000000001 517.81 234.27 529 238C538.213 241.6860000000001 791.3009999999999 496.501 797 506C810.366 526.05 794.566 556.812 779 562C768.606 565.4649999999999 751.99 569.326 741 562C736 559 721 546 622 447L510 335L397 447C300 544 284 560 279 562C273.193 563.9359999999999 266.477 567 259 567z"/></g></svg>
      </button>
      <button type="button" class="zammad-chat-header-icon js-chat-close" aria-label="<%- @T('End chat') %>">
        <svg class="zammad-chat-header-icon-close" width="17" height="17" viewBox="0 0 1010 986.5" fill="currentColor"><g transform="scale(1,-1) translate(0,-986.5)"><path d="M259 692C235.564 692 213.687 669.564 219 643C220 639 221 634 223 631C226 626 239 611 338 512L450 400L338 288C239 189 226 174 223 169C217.037 160.0560000000001 216.766 140.352 223 131C230.87 119.1950000000001 245.002 104.6 267 109C271 110 276 112 279 113C284 115 300 131 397 228L510 340L622 228C721 129 736 116 741 113C755.69 103.207 780.28 111.28 789 120C798.387 129.387 808.02 152.47 797 169C794 174 781 189 682 288L570 400L682 512C781 611 794 626 797 631C810.366 651.05 794.566 681.812 779 687C768.606 690.465 751.99 694.326 741 687C736 684 721 671 622 572L510 460L397 572C300 669 284 685 279 687C273.193 688.936 266.477 692 259 692z"/></g></svg>
      </button>
    </div>
  </div>
  <div class="zammad-chat-tab-body zammad-chat-tab-body--home is-active"></div>

  <div class="zammad-chat-tab-body zammad-chat-tab-body--messages">
    <div class="zammad-chat-modal"></div>
    <div class="zammad-scroll-hint is-hidden">
      <svg class="zammad-scroll-hint-icon" width="20" height="18" viewBox="0 0 20 18"><path d="M0,2.00585866 C0,0.898053512 0.898212381,0 1.99079514,0 L18.0092049,0 C19.1086907,0 20,0.897060126 20,2.00585866 L20,11.9941413 C20,13.1019465 19.1017876,14 18.0092049,14 L1.99079514,14 C0.891309342,14 0,13.1029399 0,11.9941413 L0,2.00585866 Z M10,14 L16,18 L16,14 L10,14 Z" fill-rule="evenodd"/></svg>
      <%- @T(@scrollHint) %>
    </div>
    <div class="zammad-chat-body"></div>
    <div class="zammad-chat-reply-indicator js-reply-indicator zammad-chat-is-hidden"></div>
    <form class="zammad-chat-controls">
      <div class="zammad-chat-emoji-picker js-emoji-picker zammad-chat-is-hidden"></div>
      <div class="zammad-chat-input" rows="1" placeholder="<%- @T(@phrases['chat_phrase_messages_compose_placeholder'] || 'Compose your message…') %>" contenteditable="true"></div>
      <div class="zammad-chat-controls-icons">
        <div class="zammad-chat-emoji-toggle js-emoji-toggle">
          <svg width="16" height="16" viewBox="0 0 1010 986.5" fill="currentColor"><g transform="scale(1,-1) translate(0,-986.5)"><path d="M518 816C572.269 816 607.844 805.045 650 793C676.847 785.33 706.197 769.535 728 755C734 751 745 745 752 740C780.122 719.913 807.295 693.49 830 667C875.205 614.26 904.582 551.09 921 469C926.277 442.611 926 432.576 926 400C926 295.901 893.852 224.779 852 162C841.594 146.39 829.555 130.555 816 117L793 94C772.933 73.933 750.076 57.33 725 43C666.224 9.414 602.538 -16 510 -16C456.467 -16 421.03 -7.723 380 4C329.755 18.355 287.91 46.922 250 74C233.797 85.574 217.93 103.0700000000001 204 117C190.573 130.427 177.435 148.348 167 164C125.575 226.137 94 296.337 94 400C94 460.342 104.183 499.549 119 544C121 550 124 560 127 566L140 592C165.724 643.448 200.981 683.9839999999999 243 720C295.099 764.656 363.178 800.025 447 812C459.05 813.722 477.947 816 490 816H518zM508 733C498 733 484 732 479 732C445.765 732 413.549 718.85 387 710C359.568 700.856 326.9220000000001 678.691 306 663C275.306 639.98 248.682 608.523 227 576C218.048 562.571 207.325 541.976 202 526C200 520 195 510 193 503C184.01 471.536 177 440.877 177 400C177 359.0800000000001 183.964 328.626 193 297C195 290 200 280 202 274C215.732 232.802 241.187 202.775 266 173C276.0950000000001 160.886 294.086 145.936 306 137C329.615 119.29 364.361 99.702 394 87C401 84 413 82 419 80C432.854 75.382 451.407 72.5990000000001 467 70C473 69 488 67 500 67C535.335 67 560.567 68.162 588 76C595 78 606 81 613 83S630 90 636 92C677.198 105.732 707.225 131.187 737 156C749.114 166.095 764.064 184.086 773 196C784.495 211.326 798.348 232.472 809 252C814 262 820 277 823 284S828 303 830 309C834.618 322.8540000000001 837.401 341.4070000000001 840 357C841 363 843 378 843 390C843 436.9 838.86 469.707 826 504C811.55 542.533 797.363 573.796 774 603C749.429 633.7139999999999 719.59 660.606 686 683C672.571 691.952 651.976 702.675 636 708C630 710 620 715 613 717C581.318 726.052 549.749 733 508 733zM427 484C427 458.255 409.5710000000001 442 383 442C340.153 442 329.724 507.908 366 520C374.133 522.71 374.992 525 387 525C403.385 525 411.847 514.153 420 506C424.2080000000001 501.792 427 491.67 427 484zM677 484C677 458.255 659.571 442 633 442C590.153 442 579.724 507.908 616 520C624.133 522.71 624.992 525 637 525C653.385 525 661.847 514.153 670 506C674.208 501.792 677 491.67 677 484zM406 317C380.43 317 364 297.736 364 272C364 262.53 368.902 256.146 373 250C384.86 232.2100000000001 405.217 221.305 425 210C444.383 198.924 469.645 190 497 190H522C539.757 190 542.767 193.46 558 196C564 197 571 200 576 202C589.984 207.5940000000001 605.783 214.026 617 223C631.995 234.996 656 247.352 656 272C656 298.346 641.948 310.7630000000001 621 316C602.528 319.694 593.18 310.944 582 302C562.888 286.7100000000001 544.151 273 510 273C476.81 273 456.499 287.2000000000001 438 302C427.262 310.5900000000001 422.427 317 406 317z"/></g></svg>
        </div>
        <div class="zammad-chat-attach js-chat-attach zammad-chat-is-hidden">
          <svg width="16" height="16" viewBox="0 0 1010 986.5" fill="currentColor"><g transform="scale(1,-1) translate(0,-986.5)"><path d="M640 826C612.498 826 594.654 824.885 574 818C552.419 810.807 530.815 803.452 514 790C509 786 499 780 494 775S420 702 341 623S195 476 191 472S181 460 177 454L163 433C149.85 413.276 141.325 394.302 135 369C126.589 335.355 121 320.855 121 275C121 198.2480000000001 141.429 149.857 172 104C194.018 70.975 222.565 44.168 255 21C300.382 -11.4159999999999 358.4220000000001 -32 436 -32C464.633 -32 482.888 -27.604 506 -21C552.83 -7.62 591.358 12.799 624 40C637.804 51.503 920.221 334.051 923 341C932.803 370.41 916.606 400 885 400C877.677 400 868.98 396.49 864 394C853.687 387.124 590.779 119.3340000000001 561 97C525.085 73.057 486.773 52 426 52C385.586 52 357.105 61.526 328 74C321 77 311 85 304 89C275.162 105.479 252.745 131.092 236 159C216.305 191.826 199.567 236.809 204 290C210.6 342.794 227.922 382.563 253 416C256 420 322 487 399 564S543 708 548 712C572.413 731.53 597.17 743 640 743C672.355 743 691.9 731.66 713 719C718 716 725 708 730 703C744.986 688.014 752.255 673.491 762 654C768.402 641.194 769 628.6700000000001 769 608C769 571.506 760.835 556.059 747 533C736.34 515.946 456.91 239.273 452 236C444.903 231.27 438.116 229 427 229C393.809 229 368.386 262.7720000000001 385 296C393.507 313.0130000000001 668.4069999999999 579.519 673 591C682.803 620.4100000000001 666.606 650 635 650C626.297 650 617.928 646.952 612 643C607.125 639.75 329.587 364.9390000000001 319 348C306.352 326.92 297 308.968 297 275C297 213.865 329.454 182.1280000000001 368 159C383.642 149.615 399.041 145 422 145C452.82 145 471.474 151.736 492 162C496 164 502 170 506 173S579 243 658 322S803 469 806 473C831.542 507.056 853 548.49 853 608C853 688.4970000000001 817.528 744.104 771 779C767 782 759 789 754 792C722.71 810.773 689.264 826 640 826z"/></g></svg>
        </div>
        <input type="file" class="js-chat-attachment-input zammad-chat-is-hidden">
        <button type="submit" class="zammad-chat-send" aria-label="<%- @T('Send') %>"<%= " style='background: #{ @background }'" if @background %>>
          <svg width="15" height="15" viewBox="0 0 1010 986.5" fill="currentColor"><g transform="scale(1,-1) translate(0,-986.5)"><path d="M887 817C905.39 817 920.353 802.938 925 789C926 785 926 780 926 774V766L789 386C714 178 651 6 650 4C640.814 -14.371 621.332 -30 594 -30C572.757 -30 551.768 -19.15 543 -6C540 -3 515 48 468 142L396 286L252 358C158 405 107 430 104 433C90.687 441.876 80 462.057 80 484C80 512.133 95.208 530.605 114 540C135.429 550.7139999999999 853.955 807.582 865 812C870 814 876 816 877 816S883 817 887 817zM720 671C719.662 671 713.743 668.74 194 481C194 481 244 455 306 424L418 368L570 519C653 602 721 671 720 671zM782 612L478 308L534 195C579 105 590 82 591 84C591 84.321 591.312 84.0940000000001 782 612z"/></g></svg>
        </button>
      </div>
    </form>
  </div>

  <div class="zammad-chat-tab-body zammad-chat-tab-body--help"></div>

  <div class="zammad-chat-tabbar"></div>

  <!-- Atas permintaan user (mockup "SISKA Widget Mockup" -- board
  IndicatorReconnecting/Restored/Lost): indikator fullpage
  semi-transparan status koneksi WebSocket widget sendiri, menutupi
  seluruh panel (isi disuntik dinamis oleh `showConnectionOverlay()`,
  lihat `connection_overlay.eco`). -->
  <!-- Audit kit Tailwind: `aria-live` -- perubahan status koneksi
  (Reconnecting -> restored/lost) dibacakan pembaca layar. -->
  <div class="zammad-chat-connection-overlay js-connection-overlay zammad-chat-is-hidden" aria-live="polite"></div>

  <!-- Atas permintaan user: layar "Terima kasih" SETELAH submit
  feedback (rating-nya sendiri sekarang inline di `.zammad-chat-body`,
  lihat `showFeedback`) tetap fullpage -- container TERPISAH dari
  overlay koneksi di atas (semantik beda, sengaja tidak dicampur),
  gaya visual scrim sama (lihat `chat.scss`). Isi disuntik dinamis
  oleh `showFeedbackThanks()`. -->
  <div class="zammad-chat-feedback-thanks-overlay js-feedback-thanks-overlay zammad-chat-is-hidden"></div>
</div>