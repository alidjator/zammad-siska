<div class="zammad-chat-offline-sent">
  <div class="zammad-chat-offline-sent-icon">
    <%- @icon('check-circle', 30, tone: 'full') %>
  </div>
  <div class="zammad-chat-offline-sent-title"><%- @T(@phrases['chat_phrase_offline_sent_title'] || 'Your message has been sent!') %></div>
  <div class="zammad-chat-offline-sent-subtitle"><%- @T(@phrases['chat_phrase_offline_sent_subtitle_prefix'] || 'Our team will reply to') %> <strong><%= @email %></strong> <%- @T(@phrases['chat_phrase_offline_sent_subtitle_suffix'] || 'as soon as an agent is available.') %></div>
  <button type="button" class="zammad-chat-offline-sent-button js-offline-sent-done"><%- @T(@phrases['chat_phrase_offline_sent_button'] || 'Continue') %></button>
</div>
