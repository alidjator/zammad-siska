<div class="zammad-chat-message zammad-chat-message--<%= @from %><%= @unreadClass %>"<% if @id: %> data-message-id="<%= @id %>"<% end %>>
  <span class="zammad-chat-message-row"><span class="zammad-chat-message-body"<%= " style='background: #{ @background }'" if @background and @from is 'customer' %>><% if @replyTo: %><span class="zammad-chat-message-quote"><%= @replyTo.substr(0, 80) %></span><% end %><%- @message %><span class="zammad-chat-message-time"><%= @time %><% if @from is 'customer': %><span class="zammad-chat-message-status zammad-chat-message-status--<%= if @isRead then 'read' else 'sent' %>" aria-label="<%- if @isRead then @T('Read') else @T('Sent') %>"><%- @icon('checks', 16) %></span><% end %></span></span><% if @from is 'agent' and @id: %><button type="button" class="zammad-chat-message-reply js-message-reply" aria-label="<%- @T('Reply') %>"><%- @icon('arrow-bend-up-left', 14) %></button><% end %></span>
</div>
