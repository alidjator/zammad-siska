<!-- Menu bubble ala WhatsApp (mockup "Menu bubble ala WhatsApp"): ikon reply
samping bubble diganti tombol panah DI DALAM bubble (pesan agent ber-id)
yg membuka dropdown (views/message_menu.eco, `openMessageMenu`). -->
<div class="zammad-chat-message zammad-chat-message--<%= @from %><%= @unreadClass %>"<% if @id: %> data-message-id="<%= @id %>"<% end %>>
  <span class="zammad-chat-message-row"><span class="zammad-chat-message-body"<%= " style='background: #{ @background }'" if @background and @from is 'customer' %>><% if @replyTo: %><span class="zammad-chat-message-quote"><%= @replyTo.substr(0, 80) %></span><% end %><%- @message %><span class="zammad-chat-message-time"><%= @time %><% if @from is 'customer': %><span class="zammad-chat-message-status zammad-chat-message-status--<%= if @isRead then 'read' else 'sent' %>" aria-label="<%- if @isRead then @T('Read') else @T('Sent') %>"><%- @icon('checks', 16) %></span><% end %></span><% if @from is 'agent' and @id: %><button type="button" class="zammad-chat-message-menu-toggle js-message-menu" aria-label="<%- @T('Message options') %>" aria-haspopup="menu" aria-expanded="false" data-kind="text"><%- @icon('caret-down', 16) %></button><% end %></span></span>
</div>
