<div class="zammad-chat-message zammad-chat-message--<%= @from %><%= @unreadClass %>"<% if @id: %> data-message-id="<%= @id %>"<% end %>>
  <span class="zammad-chat-message-body"<%= " style='background: #{ @background }'" if @background and @from is 'customer' %>>
    <% if @replyTo: %>
      <span class="zammad-chat-message-quote"><%= @replyTo.substr(0, 80) %></span>
    <% end %>
    <%- @message %>
  </span>
  <% if @id: %>
    <span class="zammad-chat-message-reply js-message-reply">&#8617;</span>
  <% end %>
</div>