<div class="zammad-chat-message zammad-chat-message--<%= @from %><%= @unreadClass %>"<% if @id: %> data-message-id="<%= @id %>"<% end %>>
  <span class="zammad-chat-message-row"><span class="zammad-chat-message-body"<%= " style='background: #{ @background }'" if @background and @from is 'customer' %>><% if @replyTo: %><span class="zammad-chat-message-quote"><%= @replyTo.substr(0, 80) %></span><% end %><%- @message %><span class="zammad-chat-message-time"><%= @time %><% if @from is 'customer': %><span class="zammad-chat-message-status zammad-chat-message-status--<%= if @isRead then 'read' else 'sent' %>" aria-label="<%- if @isRead then @T('Read') else @T('Sent') %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M0.41,13.41L6,19L7.41,17.58L1.83,12M22.24,5.58L11.66,16.17L7.5,12L6.07,13.41L11.66,19L23.66,7M18,7L16.59,5.58L10.24,11.93L11.66,13.34L18,7Z"/></svg></span><% end %></span></span><% if @from is 'agent' and @id: %><button type="button" class="zammad-chat-message-reply js-message-reply" aria-label="<%- @T('Reply') %>"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7.13 18.31h8c2.76 0 5-2.24 5-5s-2.24-5-5-5h-11"/><path d="M6.43 10.81L3.87 8.25l2.56-2.56"/></svg></button><% end %></span>
</div>
