<div class="zammad-chat-feedback">
  <div class="zammad-chat-feedback-title"><%- @T(@phrases['chat_phrase_feedback_title'] || 'How was your experience?') %></div>
  <div class="zammad-chat-feedback-subtitle"><%- @T(@phrases['chat_phrase_feedback_subtitle'] || 'Your feedback helps us improve.') %></div>

  <!-- Atas permintaan user (audit kit Tailwind, mockup "Feedback - ikuti
  kit"): bintang DIGANTI hati -- preseden rating "Heart" kit
  (`forms/form2_rating.html`, ikon `feather-heart`). Class `-star` &
  `js-feedback-star` SENGAJA dipertahankan (dipakai logic skor di
  chat-no-jquery.coffee), cuma ikonnya yg berubah. -->
  <div class="zammad-chat-feedback-stars">
    <button type="button" class="zammad-chat-feedback-star js-feedback-star" data-score="1" aria-label="1"><svg class="zammad-chat-feedback-heart" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></button>
    <button type="button" class="zammad-chat-feedback-star js-feedback-star" data-score="2" aria-label="2"><svg class="zammad-chat-feedback-heart" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></button>
    <button type="button" class="zammad-chat-feedback-star js-feedback-star" data-score="3" aria-label="3"><svg class="zammad-chat-feedback-heart" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></button>
    <button type="button" class="zammad-chat-feedback-star js-feedback-star" data-score="4" aria-label="4"><svg class="zammad-chat-feedback-heart" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></button>
    <button type="button" class="zammad-chat-feedback-star js-feedback-star" data-score="5" aria-label="5"><svg class="zammad-chat-feedback-heart" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></button>
  </div>

  <textarea class="zammad-chat-feedback-textarea js-feedback-comment" placeholder="<%- @T(@phrases['chat_phrase_feedback_comment_placeholder'] || 'Add a comment (optional)') %>"></textarea>

  <div class="zammad-chat-feedback-error js-feedback-error zammad-chat-is-hidden"></div>

  <div class="zammad-chat-feedback-actions">
    <button type="button" class="zammad-chat-feedback-skip js-feedback-skip"><%- @T(@phrases['chat_phrase_feedback_skip_button'] || 'Maybe later') %></button>
    <button type="button" class="zammad-chat-feedback-submit js-feedback-submit"><%- @T(@phrases['chat_phrase_feedback_submit_button'] || 'Submit') %></button>
  </div>
</div>
