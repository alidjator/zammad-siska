<div class="zammad-chat-waiting">
  <div class="zammad-chat-waiting-spinner">
    <span class="zammad-chat-waiting-spinner-track"></span>
    <span class="zammad-chat-waiting-spinner-arc zammad-chat-waiting-spinner-arc--danger"></span>
    <span class="zammad-chat-waiting-spinner-icon zammad-chat-waiting-spinner-icon--danger">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
    </span>
  </div>
  <div class="zammad-chat-waiting-title"><%- @T(@phrases['chat_phrase_ending_title'] || 'Ending conversation…') %></div>
  <div class="zammad-chat-waiting-subtext"><%- @T(@phrases['chat_phrase_ending_subtitle'] || 'Please wait a moment.') %></div>
</div>
