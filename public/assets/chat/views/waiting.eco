<div class="zammad-chat-waiting">
  <!-- Atas permintaan user (audit kit Able Pro TAILWIND baru, mockup
  "Waiting.dc.html" opsi 1 disetujui) -- spinner SEKARANG satu elemen
  polos (lihat chat.scss), track/ikon di tengah DIHAPUS, tidak ada
  padanannya di preseden kit baru. -->
  <div class="zammad-chat-waiting-spinner"></div>
  <div class="zammad-chat-waiting-title"><%- @T(@phrases['chat_phrase_waiting_title'] || 'Connecting you to an agent…') %></div>
  <div class="zammad-chat-waiting-subtext"><%- @T(@phrases['chat_phrase_waiting_subtitle'] || 'All colleagues are busy.') %></div>
  <% if @position: %>
    <div class="zammad-chat-waiting-position"><%- @T(@phrases['chat_phrase_waiting_queue_position'] || 'You are on waiting list position <strong>%s</strong>.', @position) %></div>
  <% end %>
  <button type="button" class="zammad-chat-waiting-cancel js-waiting-cancel"><%- @T(@phrases['chat_phrase_waiting_cancel_button'] || 'Cancel') %></button>
</div>
