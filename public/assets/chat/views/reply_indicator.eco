<span class="zammad-chat-reply-indicator-text"><%- @T(@phrases['chat_phrase_messages_reply_prefix'] || 'Replying to:') %> <%= @snippet %></span>
<!-- Audit ulang kit Tailwind: karakter teks `&times;` di <span> diganti
<button> + ikon Tabler `ti ti-x` (glyph asli kit, pola btn-link-secondary)
supaya bisa difokus & dipakai lewat keyboard. -->
<button type="button" class="zammad-chat-reply-indicator-cancel js-reply-cancel" aria-label="<%- @T('Cancel reply') %>"><%- @icon('x', 14) %></button>
