<li class="zammad-chat-kb-result">
  <a href="<%= @url %>" target="_blank" rel="noopener noreferrer" class="zammad-chat-kb-result-link">
    <span class="zammad-chat-kb-result-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v5h5"/></svg>
    </span>
    <span class="zammad-chat-kb-result-text">
      <span class="zammad-chat-kb-result-title"><%- @title %></span>
      <span class="zammad-chat-kb-result-body"><%- @body %></span>
    </span>
    <svg class="zammad-chat-kb-result-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg>
  </a>
</li>
