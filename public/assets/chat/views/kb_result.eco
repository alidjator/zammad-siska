<li class="zammad-chat-kb-result">
  <a href="<%= @url %>" target="_blank" rel="noopener noreferrer" class="zammad-chat-kb-result-link">
    <span class="zammad-chat-kb-result-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7v10c0 3-1.5 5-5 5H8c-3.5 0-5-2-5-5V7c0-3 1.5-5 5-5h8c3.5 0 5 2 5 5Z"/><path d="M14.5 4.5v2c0 1.1.9 2 2 2h2M8 13h4M8 17h8"/></svg>
    </span>
    <span class="zammad-chat-kb-result-text">
      <span class="zammad-chat-kb-result-title"><%- @title %></span>
      <span class="zammad-chat-kb-result-body"><%- @body %></span>
    </span>
    <svg class="zammad-chat-kb-result-chevron" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 9.33v5.34c0 3.32 2.35 4.67 5.22 3.02l1.28-.74c.31-.18.5-.51.5-.87V7.92c0-.36-.19-.69-.5-.87l-1.28-.74C8.35 4.66 6 6.01 6 9.33z"/><path d="M14 8.79v6.43c0 .39.42.63.75.43l1.1-.64c2.87-1.65 2.87-4.37 0-6.02l-1.1-.64a.503.503 0 00-.75.44z" opacity=".4"/></svg>
  </a>
</li>
